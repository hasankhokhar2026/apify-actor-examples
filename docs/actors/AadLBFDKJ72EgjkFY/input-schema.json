{
  "description": "Scrape Numbeo city prices, cost-of-living / quality-of-life / crime / health-care / pollution / traffic / property indices, comparisons, country profiles, market prices and worldwide rankings. Currency and measurement units are configurable.",
  "properties": {
    "autoEscalateOnBlock": {
      "default": true,
      "description": "When a direct request is rate-limited (HTTP 429) or challenged, retry through Apify Proxy for the rest of the run.",
      "editor": "checkbox",
      "prefill": true,
      "title": "Auto-escalate on rate limit",
      "type": "boolean"
    },
    "cities": {
      "default": [],
      "description": "Additional cities to scrape in the same run. Each city is resolved and scraped in turn.",
      "editor": "stringList",
      "prefill": [],
      "title": "Cities (batch)",
      "type": "array"
    },
    "city": {
      "description": "City name as shown on Numbeo, or a Numbeo city URL. Examples: `New York`, `Berlin`, `Tokyo`, `Sao Paulo`, `Cambridge, MA`. The actor resolves the exact Numbeo city automatically.",
      "editor": "textfield",
      "prefill": "New York",
      "sectionCaption": "Cities",
      "sectionDescription": "Used by every city mode, food/restaurant/gas modes, and comparison mode.",
      "title": "City",
      "type": "string"
    },
    "city1": {
      "description": "First city in the comparison (e.g. `New York, NY` or `Berlin`).",
      "editor": "textfield",
      "title": "City 1 (comparison)",
      "type": "string"
    },
    "city2": {
      "description": "Second city in the comparison (e.g. `Berlin`).",
      "editor": "textfield",
      "title": "City 2 (comparison)",
      "type": "string"
    },
    "countries": {
      "default": [],
      "description": "Additional country names for the country and market-price modes.",
      "editor": "stringList",
      "prefill": [],
      "title": "Countries (batch)",
      "type": "array"
    },
    "country": {
      "default": "",
      "description": "Country name as shown on Numbeo (English). Used by `country`, `foodPrices`, `restaurantPrices`, `gasPrices` and `groceryPrices` modes.",
