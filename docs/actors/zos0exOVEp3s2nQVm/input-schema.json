    "isFree": {
      "default": false,
      "description": "When enabled, only return free resources.",
      "prefill": false,
      "title": "Free resources only",
      "type": "boolean"
    },
    "maxItems": {
      "default": 24,
      "description": "Maximum number of product records to return.",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 24,
      "title": "Max items",
      "type": "integer"
    },
    "minRating": {
      "description": "Minimum average rating (TpT uses 1–5 star scale).",
      "maximum": 5,
      "minimum": 0,
      "title": "Min rating",
      "type": "number"
    },
    "minReviews": {
      "description": "Minimum number of reviews/ratings.",
      "maximum": 1000000,
      "minimum": 0,
      "title": "Min reviews",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to scrape.",
      "editor": "select",
      "enum": [
        "search",
        "byGrade",
        "bySubject",
        "getProduct",
        "getStore"
      ],
      "enumTitles": [
        "Search resources by keyword",
        "Browse resources by grade level",
        "Browse resources by subject area",
        "Get product details by URL(s)",
        "Get all products from a teacher's store"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "searchQuery": {
      "default": "multiplication worksheets",
      "description": "Keyword(s) to search for resources (mode=search).",
      "editor": "textfield",
      "prefill": "multiplication worksheets",
      "title": "Search query",
      "type": "string"
    },
    "startUrls": {
      "default": [],
      "description": "TpT product or store URLs (modes: getProduct, getStore). Example: https://www.teacherspayteachers.com/Product/Multiplication-Worksheets-4061393",
