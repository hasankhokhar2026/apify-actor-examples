    "jobType": {
      "default": "",
      "description": "Only jobs with this employment type.",
      "editor": "select",
      "enum": [
        "",
        "F",
        "P",
        "C",
        "T",
        "V",
        "I",
        "O"
      ],
      "enumTitles": [
        "Any",
        "Full-time",
        "Part-time",
        "Contract",
        "Temporary",
        "Volunteer",
        "Internship",
        "Other"
      ],
      "title": "Job type",
      "type": "string"
    },
    "jobUrls": {
      "description": "Scrape specific job postings: paste job links (linkedin.com/jobs/view/...) or numeric job IDs. Postings that have been taken down are skipped.",
      "editor": "stringList",
      "title": "Job links or IDs",
      "type": "array"
    },
    "language": {
      "default": "en",
      "description": "Language LinkedIn uses for labels such as job type and seniority. Job descriptions stay in the language they were written in. Locations must still be typed in English.",
      "editor": "select",
      "enum": [
        "en",
        "es",
        "fr",
        "de",
        "pt"
      ],
      "enumTitles": [
        "English",
        "Spanish",
        "French",
        "German",
        "Portuguese"
      ],
      "title": "Language of LinkedIn labels",
      "type": "string"
    },
    "locations": {
      "description": "Cities, regions or countries in English (e.g. 'Germany', 'Austin, Texas', 'London Area, United Kingdom'). Every keyword is searched in each location. A location LinkedIn doesn't recognise is reported and skipped rather than silently searched as the United States. Leave empty to search worldwide.",
      "editor": "stringList",
      "prefill": [
        "United States"
      ],
      "sectionCaption": "Where",
      "sectionDescription": "Each search returns at most 1,000 jobs, so list several locations to collect more.",
      "title": "Locations",
      "type": "array"
    },
    "maxItems": {
      "default": 100,
      "description": "Stop after saving this many jobs. A single keyword + location search returns at most 1,000 jobs; add keywords or locations to collect more.",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 3,
      "title": "Maximum jobs",
      "type": "integer"
    },
    "minYearlySalary": {
      "description": "Skip jobs whose stated pay range tops out below this yearly amount. Hourly, weekly and monthly pay is converted to a yearly figure. The amount is compared in the job's own currency, so set 'Salary currency' to compare like with like. Jobs without a stated salary are kept unless 'Only jobs with a salary' is on.",
      "maximum": 10000000,
      "minimum": 0,
      "title": "Minimum yearly salary",
      "type": "integer"
    },
    "requireRecruiter": {
      "default": false,
      "description": "Only jobs where LinkedIn shows the person who posted the job.",
      "prefill": false,
      "title": "Only jobs with a named recruiter",
      "type": "boolean"
    },
    "requireSalary": {
      "default": false,
      "description": "Only jobs that state their pay, either in LinkedIn's pay range box or in the job description.",
      "prefill": false,
      "title": "Only jobs with a salary",
      "type": "boolean"
    },
