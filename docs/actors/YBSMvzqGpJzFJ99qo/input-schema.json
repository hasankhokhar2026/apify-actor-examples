{
  "description": "Search LinkedIn jobs by keyword, location and company, or scrape specific job links, with salary, applicant and company details. No LinkedIn account needed.",
  "properties": {
    "companies": {
      "description": "Only jobs from these employers. Enter company names (e.g. 'General Motors'), LinkedIn company or university page links, or numeric company IDs. Leave the keywords empty to get all of a company's open jobs.",
      "editor": "stringList",
      "title": "Companies",
      "type": "array"
    },
    "companySizes": {
      "default": [],
      "description": "Only jobs from employers of these sizes, as listed on their LinkedIn page. Each employer's page is looked up once. Jobs whose employer size isn't listed are kept.",
      "editor": "select",
      "items": {
        "enum": [
          "1-10",
          "11-50",
          "51-200",
          "201-500",
          "501-1000",
          "1001-5000",
          "5001-10000",
          "10001+"
        ],
        "enumTitles": [
          "1-10 employees",
          "11-50 employees",
          "51-200 employees",
          "201-500 employees",
          "501-1,000 employees",
          "1,001-5,000 employees",
          "5,001-10,000 employees",
          "10,001+ employees"
        ],
        "type": "string"
      },
      "title": "Company size",
      "type": "array"
    },
    "distance": {
      "default": "",
      "description": "Search radius around a city-level location, in miles.",
      "editor": "select",
      "enum": [
        "",
        "0",
        "5",
        "10",
        "25",
        "50",
        "100"
      ],
      "enumTitles": [
        "LinkedIn default",
        "Exact location only",
        "5 miles (8 km)",
        "10 miles (16 km)",
        "25 miles (40 km)",
        "50 miles (80 km)",
        "100 miles (160 km)"
      ],
      "title": "Distance from location",
      "type": "string"
    },
    "easyApply": {
      "default": false,
      "description": "Only jobs you can apply to directly on LinkedIn.",
      "prefill": false,
      "title": "Easy Apply only",
      "type": "boolean"
    },
    "enrichmentDepth": {
      "default": "standard",
      "description": "Standard returns each job's core details. Extended also adds similar jobs, 'people also viewed' jobs, related searches and LinkedIn's numeric industry and title IDs, and asks LinkedIn again when the exact posting time is missing, so it takes longer per job.",
      "editor": "select",
      "enum": [
        "standard",
        "full"
      ],
      "enumTitles": [
        "Standard",
        "Extended (slower)"
      ],
      "title": "Job page depth",
      "type": "string"
    },
    "excludeCompanies": {
      "description": "Skip jobs from these employers (exact company name or LinkedIn company page link).",
      "editor": "stringList",
      "title": "Exclude companies",
      "type": "array"
    },
    "excludeJobIds": {
      "description": "Job IDs (the 'id' field of an earlier run) to leave out, so scheduled runs return only new postings.",
      "editor": "stringList",
      "title": "Skip these job IDs",
      "type": "array"
    },
    "excludeStaffingAgencies": {
      "default": false,
      "description": "Skip jobs posted by employers in LinkedIn's 'Staffing and Recruiting' industry.",
      "prefill": false,
      "title": "Exclude staffing agencies",
      "type": "boolean"
    },
    "excludeTitleKeywords": {
      "description": "Skip jobs whose title contains any of these words, e.g. 'Senior' or 'Intern'.",
      "editor": "stringList",
      "title": "Title must not contain",
      "type": "array"
    },
    "experienceLevel": {
      "default": "",
      "description": "Only jobs listed at this seniority level on LinkedIn. Jobs that LinkedIn lists as 'Not Applicable' are left out when a level is chosen.",
      "editor": "select",
      "enum": [
        "",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ],
      "enumTitles": [
        "Any",
        "Internship",
        "Entry level",
        "Associate",
        "Mid-Senior level",
        "Director",
        "Executive"
      ],
      "title": "Experience level",
      "type": "string"
    },
    "geoIds": {
      "description": "Optional numeric LinkedIn location IDs (the geoId value in a LinkedIn search link, e.g. 101282230 for Germany). Use these for exact places in any language.",
      "editor": "stringList",
      "title": "LinkedIn location IDs",
      "type": "array"
    },
    "includeCompanyDetails": {
      "default": true,
      "description": "Add each employer's LinkedIn profile: industry, size, headquarters, website, founding year, office locations, followers, tagline and description. Fetched once per company.",
      "prefill": false,
      "title": "Include company profile",
      "type": "boolean"
    },
    "includeTitleKeywords": {
      "description": "Keep only jobs whose title contains at least one of these words (not case-sensitive). Useful because LinkedIn's keyword matching is broad.",
      "editor": "stringList",
      "title": "Title must contain",
      "type": "array"
    },
