        "Recommended",
        "Property Size (High to Low)",
        "Property Size (Low to High)",
        "Year Built - Newest",
        "Year Built - Oldest",
        "Highest Price",
        "Lowest Price"
      ],
      "prefill": "recommended",
      "title": "Sort by",
      "type": "string"
    },
