{
  "description": "Search United Real Estate for homes for sale by city, state, ZIP code, or keyword, with property type, status, price, size, and beds/baths filters.",
  "properties": {
    "city": {
      "description": "City to search, e.g. `Austin`. Leave blank to search by ZIP code or keyword instead.",
      "editor": "textfield",
      "prefill": "Austin",
      "title": "City",
      "type": "string"
    },
    "keyword": {
      "description": "Free-text keyword search (searched nationwide if no city/state/ZIP is set).",
      "editor": "textfield",
      "title": "Keyword",
      "type": "string"
    },
    "listingStatuses": {
      "default": [],
      "description": "Restrict to one or more listing statuses. Empty = active listings only (site default).",
      "editor": "select",
      "items": {
        "enum": [
          "10001",
          "10005",
          "10011"
        ],
        "enumTitles": [
          "Active",
          "Pending",
          "Coming Soon"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Listing status",
      "type": "array",
      "uniqueItems": true
    },
    "maxBathrooms": {
      "description": "Maximum number of bathrooms.",
      "maximum": 20,
      "minimum": 0,
      "title": "Max bathrooms",
      "type": "integer"
    },
    "maxBedrooms": {
      "description": "Maximum number of bedrooms.",
      "maximum": 20,
      "minimum": 0,
      "title": "Max bedrooms",
      "type": "integer"
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on emitted listings. Results are fetched 250 at a time (one page); set higher than 250 to page through more of a broad search's matches.",
      "maximum": 2000,
      "minimum": 1,
      "prefill": 50,
      "title": "Max items",
      "type": "integer"
    },
    "maxPrice": {
      "description": "Maximum listing price.",
      "maximum": 500000000,
      "minimum": 0,
      "title": "Max price (USD)",
      "type": "integer"
    },
    "maxSqft": {
      "description": "Maximum interior square footage.",
      "maximum": 100000,
      "minimum": 0,
      "title": "Max square feet",
      "type": "integer"
    },
    "minBathrooms": {
      "description": "Minimum number of bathrooms.",
      "maximum": 20,
      "minimum": 0,
      "title": "Min bathrooms",
      "type": "integer"
    },
    "minBedrooms": {
      "description": "Minimum number of bedrooms.",
      "maximum": 20,
      "minimum": 0,
      "title": "Min bedrooms",
      "type": "integer"
    },
    "minPrice": {
      "description": "Minimum listing price.",
      "maximum": 500000000,
      "minimum": 0,
      "title": "Min price (USD)",
      "type": "integer"
    },
    "minSqft": {
      "description": "Minimum interior square footage.",
      "maximum": 100000,
      "minimum": 0,
      "title": "Min square feet",
      "type": "integer"
    },
    "propertyTypes": {
      "default": [],
      "description": "Restrict to one or more property types. Empty = all types.",
      "editor": "select",
      "items": {
        "enum": [
          "1",
          "2",
          "3",
          "4",
          "5",
          "6",
          "7",
          "8",
          "10",
          "11",
          "12"
        ],
        "enumTitles": [
          "Single Family / Detached",
          "Multi-family",
          "Condo / Townhome / Apartment",
          "Farm / Ranch",
          "Lot and Land",
          "Commercial",
          "Mobile",
          "Waterfront",
          "Other",
          "Industrial",
          "Recreational"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Property types",
      "type": "array",
      "uniqueItems": true
    },
    "sortBy": {
      "default": "recommended",
      "description": "Result ordering.",
      "editor": "select",
      "enum": [
        "recommended",
        "PropertySize desc",
        "PropertySize",
        "YearBuilt desc",
        "YearBuilt",
        "ListPrice desc",
        "ListPrice"
      ],
