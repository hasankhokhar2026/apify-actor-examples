{
  "properties": {
    "category": {
      "default": "all",
      "description": "Industry category filter (keyword match against event tags / description).",
      "editor": "select",
      "enum": [
        "all",
        "apparel",
        "auto",
        "banking",
        "building",
        "education",
        "entertainment",
        "food",
        "health",
        "industrial",
        "it",
        "medical",
        "science",
        "sports",
        "technology",
        "travel"
      ],
      "enumTitles": [
        "All",
        "Apparel & Fashion",
        "Auto & Automotive",
        "Banking & Finance",
        "Building & Construction",
        "Education & Training",
        "Entertainment & Arts",
        "Food & Beverage",
        "Health & Fitness",
        "Industrial & Manufacturing",
        "IT & Technology",
        "Medical & Pharma",
        "Science & Research",
        "Sports",
        "Technology",
        "Travel & Tourism"
      ],
      "title": "Category",
      "type": "string"
    },
    "city": {
      "description": "City slug (e.g. 'berlin', 'new-york'). Creates https://10times.com/<city>.",
      "editor": "textfield",
      "title": "City",
      "type": "string"
    },
    "country": {
      "default": "WW",
      "description": "Two-letter country code or 'WW' for worldwide. When set, ONLY events located in that country are returned — events from other countries are filtered out even if they appear on the listing page. City listing pages (e.g. https://10times.com/london-uk) are followed automatically to find events in the requested country.",
      "editor": "select",
      "enum": [
        "WW",
        "US",
        "GB",
        "DE",
        "FR",
        "ES",
        "IT",
        "NL",
        "AU",
        "CA",
        "JP",
        "IN",
        "BR",
        "MX",
        "CN",
        "SG"
      ],
      "enumTitles": [
        "Worldwide",
        "US",
        "UK",
        "Germany",
        "France",
        "Spain",
        "Italy",
        "Netherlands",
        "Australia",
        "Canada",
        "Japan",
        "India",
        "Brazil",
        "Mexico",
        "China",
        "Singapore"
      ],
      "prefill": "WW",
      "title": "Country",
      "type": "string"
    },
    "endDate": {
      "description": "Only events starting on or before this date.",
      "editor": "textfield",
      "title": "End Date (YYYY-MM-DD)",
      "type": "string"
    },
    "eventType": {
      "default": "all",
      "description": "Filter by type (applied client-side on discovered events).",
      "editor": "select",
      "enum": [
        "all",
        "tradeshow",
        "conference",
        "workshop",
        "festival"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "maxItems": {
      "default": 20,
      "description": "Maximum number of events to return in the dataset.",
      "editor": "number",
      "maximum": 500,
      "minimum": 1,
      "prefill": 3,
      "title": "Max Items",
      "type": "integer"
    },
    "onlineOnly": {
      "default": false,
      "description": "Return only online / virtual events.",
      "title": "Online Events Only",
      "type": "boolean"
    },
    "query": {
      "description": "Free-text event search (builds https://10times.com/?query=<q>).",
      "editor": "textfield",
      "title": "Search Query",
      "type": "string"
    },
    "sortBy": {
      "default": "date",
      "description": "Sort events by date, relevance score, name, follower count, or distance.",
      "editor": "select",
      "enum": [
        "date",
        "score",
        "name",
        "follows",
        "distance"
      ],
      "title": "Sort By",
      "type": "string"
    },
    "sortType": {
      "default": "asc",
      "description": "Sort order: ascending or descending.",
      "editor": "select",
      "enum": [
        "asc",
        "desc"
      ],
      "title": "Sort Direction",
      "type": "string"
    },
    "startDate": {
      "description": "Only events starting on or after this date.",
      "editor": "textfield",
      "title": "Start Date (YYYY-MM-DD)",
      "type": "string"
    },
    "startUrls": {
      "description": "10times URLs. Event URLs (https://10times.com/<event-slug>) are scraped directly. City URLs (https://10times.com/<city>-<country>) enumerate events.",
      "editor": "stringList",
      "prefill": [
        "https://10times.com/ces-las-vegas"
      ],
      "title": "Start URLs",
      "type": "array"
    }
  },
  "schemaVersion": 1,
  "title": "10times Events Scraper Input",
  "type": "object"
}
