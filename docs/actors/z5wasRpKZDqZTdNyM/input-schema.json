{
  "description": "Search Coursera's public catalog by keyword, category, partner or URL, with filters for product type, level, duration, cost, language, subtitle, skills and tools. Optional detail enrichment adds instructors, syllabus, enrollment, page views, rating breakdown and top reviews.",
  "properties": {
    "costs": {
      "default": [],
      "description": "Only include products with these cost labels.",
      "editor": "select",
      "items": {
        "enum": [
          "Free",
          "Free Trial",
          "Paid",
          "Preview"
        ],
        "enumTitles": [
          "Free",
          "Free trial",
          "Paid",
          "Preview"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Cost",
      "type": "array",
      "uniqueItems": true
    },
    "courseraPlusStatus": {
      "default": "",
      "description": "Filter by Coursera Plus inclusion.",
      "editor": "select",
      "enum": [
        "",
        "included",
        "notIncluded"
      ],
      "enumTitles": [
        "Any",
        "Included in Coursera Plus",
        "Not included in Coursera Plus"
      ],
      "prefill": "",
      "title": "Coursera Plus",
      "type": "string"
    },
    "difficulties": {
      "default": [],
      "description": "Only include products at these difficulty levels.",
      "editor": "select",
      "items": {
        "enum": [
          "BEGINNER",
          "INTERMEDIATE",
          "ADVANCED",
          "MIXED"
        ],
        "enumTitles": [
          "Beginner",
          "Intermediate",
          "Advanced",
          "Mixed"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Difficulty levels",
      "type": "array",
      "uniqueItems": true
    },
    "durations": {
      "default": [],
      "description": "Only include products in these duration bands.",
      "editor": "select",
      "items": {
        "enum": [
          "Less Than 2 Hours",
          "1-4 Weeks",
          "1-3 Months",
          "3-6 Months",
          "6-12 Months",
          "1-4 Years"
        ],
        "enumTitles": [
          "Less than 2 hours",
          "1-4 weeks",
          "1-3 months",
          "3-6 months",
          "6-12 months",
          "1-4 years"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Durations",
      "type": "array",
      "uniqueItems": true
    },
    "freeOnly": {
      "default": false,
      "description": "Only return products whose Coursera cost label is Free. The older audit/verified filter is no longer exposed by Coursera; access flags are included in every record.",
      "prefill": false,
      "title": "Free products only",
      "type": "boolean"
    },
    "handsOnLearningTypes": {
      "default": [],
      "description": "Only include products with these hands-on learning formats.",
      "editor": "select",
      "items": {
        "enum": [
          "Dialogues And Role Plays",
          "Guided Projects",
          "Coding Labs",
          "Cloud Sandboxes",
          "Gen AI Playgrounds"
        ],
        "enumTitles": [
          "Dialogues and role plays",
          "Guided projects",
          "Coding labs",
          "Cloud sandboxes",
          "Gen AI playgrounds"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Hands-on learning types",
      "type": "array",
      "uniqueItems": true
    },
    "includeDetails": {
      "default": false,
      "description": "Fetch each product page to add instructors, syllabus/modules, total enrollment, page views, rating breakdown, top reviews, learning objectives, recommended background and membership. Slower: one extra request per record. Lookup modes (bySlug/byUrl/byIds) always return detail fields.",
      "prefill": false,
      "title": "Include course detail fields",
      "type": "boolean"
    },
