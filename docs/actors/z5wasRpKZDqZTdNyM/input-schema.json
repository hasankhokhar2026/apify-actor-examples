      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Skills",
      "type": "array"
    },
    "slugs": {
      "default": [],
      "description": "Course or specialization slugs, e.g. `machine-learning`. A full Coursera URL is also accepted.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Slugs (mode=bySlug)",
      "type": "array"
    },
    "sortBy": {
      "default": "BEST_MATCH",
      "description": "Result order for search, browse, byCategory and byPartner modes.",
      "editor": "select",
      "enum": [
        "BEST_MATCH",
        "NEW"
      ],
      "enumTitles": [
        "Best match",
        "Newest"
      ],
      "prefill": "BEST_MATCH",
      "title": "Sort by",
      "type": "string"
    },
