    "mode": {
      "default": "search",
      "description": "What to fetch. `bySlug`, `byUrl` and `byIds` always return detail fields for the looked-up products.",
      "editor": "select",
      "enum": [
        "search",
        "byCategory",
        "byPartner",
        "bySlug",
        "byUrl",
        "byIds",
        "browse",
        "searchSpecializations"
      ],
      "enumTitles": [
        "Search by keyword",
        "Browse a category (topic)",
        "Browse a partner / university",
        "Look up by slug",
        "Look up by URL",
        "Look up by product ID",
        "Browse the catalog without a keyword",
        "Search specializations (legacy)"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "partners": {
      "default": [],
      "description": "Partner or university names, e.g. `IBM`, `Google`, `Stanford Online`, `DeepLearning.AI`. Matched to the live Coursera partner filter; partial names such as `Stanford` are resolved to the closest partner.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Partners / universities",
      "type": "array"
    },
    "productIds": {
      "default": [],
      "description": "Coursera product IDs such as `course~8UjeMk-mEeit4g4GsxE4dg` or `s12n~nOOfCDWeEeuiZgo2K4rorQ`. Bare course IDs are also accepted.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Product IDs (mode=byIds)",
      "type": "array"
    },
    "productTypes": {
      "default": [],
      "description": "Limit results to these Coursera product types. Leave empty for every type.",
      "editor": "select",
      "items": {
        "enum": [
          "COURSE",
          "SPECIALIZATION",
          "GUIDED_PROJECT",
          "PROJECT",
          "PROFESSIONAL_CERTIFICATE",
          "DEGREE",
          "GRADUATE_CERTIFICATE",
          "MASTERTRACK",
          "UNIVERSITY_CERTIFICATE",
          "POSTGRADUATE_DIPLOMA"
        ],
        "enumTitles": [
          "Course",
          "Specialization",
          "Guided Project",
          "Project",
          "Professional Certificate",
          "Degree",
          "Graduate Certificate",
          "MasterTrack Certificate",
          "University Certificate",
          "Postgraduate Diploma"
        ],
        "type": "string"
      },
      "prefill": [
        "COURSE"
      ],
      "sectionCaption": "Catalog filters",
      "sectionDescription": "All filters are optional. They apply to search, browse, byCategory and byPartner modes (byUrl applies the filters embedded in search URLs).",
      "title": "Learning product types",
      "type": "array",
      "uniqueItems": true
    },
    "query": {
      "default": "",
      "description": "Keyword search (mode=search, searchSpecializations). Optional narrowing keyword for byCategory and byPartner.",
      "editor": "textfield",
      "prefill": "machine learning",
      "title": "Search query",
      "type": "string"
    },
    "skills": {
      "default": [],
      "description": "Skill names, e.g. `Python Programming`, `Machine Learning`. Matched to the live skill filter; partial names are resolved when possible.",
