{
  "description": "Search GitHub Marketplace for apps, actions, or integrations. Browse by category or fetch specific listings by slug.",
  "properties": {
    "category": {
      "description": "Filter by marketplace category (used in byCategory and search modes).",
      "editor": "select",
      "enum": [
        "api-management",
        "chat",
        "code-quality",
        "code-review",
        "continuous-integration",
        "dependency-management",
        "deployment",
        "ides",
        "learning",
        "monitoring",
        "project-management",
        "publishing",
        "recently-added",
        "security",
        "support",
        "testing",
        "utilities"
      ],
      "enumTitles": [
        "API Management",
        "Chat",
        "Code Quality",
        "Code Review",
        "Continuous Integration",
        "Dependency Management",
        "Deployment",
        "IDEs",
        "Learning",
        "Monitoring",
        "Project Management",
        "Publishing",
        "Recently Added",
        "Security",
        "Support",
        "Testing",
        "Utilities"
      ],
      "title": "Category",
      "type": "string"
    },
    "maxItems": {
      "default": 50,
      "description": "Maximum number of listings to scrape.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 50,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "searchApps",
      "description": "What to scrape from GitHub Marketplace.",
      "editor": "select",
      "enum": [
        "searchApps",
        "searchActions",
        "byCategory",
        "bySlug"
      ],
      "enumTitles": [
        "Search apps & integrations",
        "Search GitHub Actions",
        "Browse by category",
        "Fetch by slug"
      ],
      "prefill": "searchApps",
      "title": "Mode",
      "type": "string"
    },
    "planType": {
      "default": "all",
      "description": "Filter listings by pricing model.",
      "editor": "select",
      "enum": [
        "all",
        "free",
        "paid",
        "free_trials"
      ],
      "enumTitles": [
        "All plans",
        "Free only",
        "Paid only",
        "Free trials available"
      ],
      "prefill": "all",
      "title": "Plan type",
      "type": "string"
    },
    "searchQuery": {
      "default": "code review",
      "description": "Keyword to search for (used in searchApps and searchActions modes).",
      "editor": "textfield",
      "prefill": "code review",
      "title": "Search query",
      "type": "string"
    },
    "slugs": {
      "default": [],
      "description": "List of marketplace listing slugs to fetch (e.g. 'github-actions', 'dependabot'). Used in bySlug mode.",
      "editor": "stringList",
      "prefill": [],
      "title": "Slugs (mode=bySlug)",
      "type": "array"
    },
    "sortBy": {
      "default": "best-match",
      "description": "How to sort the results.",
      "editor": "select",
      "enum": [
        "best-match",
        "most-installed",
        "newest"
      ],
      "enumTitles": [
        "Best match",
        "Most installed",
        "Newest"
      ],
      "prefill": "best-match",
      "title": "Sort by",
      "type": "string"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "GitHub Marketplace Scraper Input",
  "type": "object"
}
