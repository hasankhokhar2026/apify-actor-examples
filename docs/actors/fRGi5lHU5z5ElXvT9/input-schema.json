{
  "description": "Look up handles on 29 verified platforms, check availability, or turn full names into handle candidates.",
  "properties": {
    "coverage": {
      "default": "verified",
      "description": "verified uses the 29 platforms that passed a known-handle plus random-handle gate. extended adds 400+ best-effort platforms at low confidence.",
      "editor": "select",
      "enum": [
        "verified",
        "extended"
      ],
      "enumTitles": [
        "Verified (29 platforms, high accuracy)",
        "Extended (400+ platforms, best effort)"
      ],
      "prefill": "verified",
      "sectionCaption": "Coverage & Platforms",
      "sectionDescription": "Verified platforms carry hard status or content-signature rules. Extended platforms are labelled low confidence and never mixed silently with verified results.",
      "title": "Coverage",
      "type": "string"
    },
    "maxConcurrency": {
      "default": 12,
      "description": "Concurrent checks. The default of 12 is the validated safe value for the verified set; per-host requests are limited further.",
      "maximum": 12,
      "minimum": 1,
      "prefill": 12,
      "sectionCaption": "Limits",
      "sectionDescription": "Caps protect both the target platforms and your run time.",
      "title": "Max concurrency",
      "type": "integer"
    },
    "maxResults": {
      "default": 500,
      "description": "Maximum profile/check rows to emit. The summary row is always emitted and is not counted.",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 10,
      "title": "Max results",
      "type": "integer"
    },
    "mode": {
      "default": "lookup",
      "description": "lookup returns found profiles (plus blocked/unknown checks), availability returns one row per platform with available/taken/unknown, and name_search generates handle candidates from a full name.",
      "editor": "select",
      "enum": [
        "lookup",
        "availability",
        "name_search"
      ],
      "enumTitles": [
        "Lookup handles",
        "Check availability",
        "Search by full name"
      ],
      "prefill": "lookup",
      "sectionCaption": "Search Settings",
      "sectionDescription": "Choose what to check. lookup and availability read `usernames`; name_search reads `names`.",
      "title": "Mode",
      "type": "string"
    },
    "names": {
      "description": "Full names for name_search. The actor builds up to 10 handle candidates per name, checks them, and scores the matches. Maximum 50 per run.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Full names (name_search)",
      "type": "array"
    },
