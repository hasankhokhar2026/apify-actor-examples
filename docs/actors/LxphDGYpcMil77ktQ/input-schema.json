        "Almada",
        "Amadora",
        "Loures",
        "Gaia",
        "Vila Nova de Gaia",
        "Matosinhos",
        "Guimaraes",
        "Odivelas",
        "Gondomar",
        "Maia",
        "Barcelos"
      ],
      "prefill": "lisboa",
      "title": "Location (concelho / city)",
      "type": "string"
    },
    "maxItems": {
      "default": 20,
      "description": "Hard cap on the number of business records to return.",
      "maximum": 2000,
      "minimum": 1,
      "prefill": 20,
      "title": "Max items",
      "type": "integer"
    },
    "minRating": {
      "default": "",
      "description": "Only return businesses rated at least this many stars, e.g. '4' for 4.0+. Businesses with no rating are still included (ratings are only shown on pai.pt once a business has reviews).",
      "editor": "select",
      "enum": [
        "",
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "enumTitles": [
        "No minimum (all businesses)",
        "1+ stars",
        "2+ stars",
        "3+ stars",
        "4+ stars",
        "5 stars only"
      ],
      "prefill": "",
      "title": "Minimum rating",
      "type": "string"
    },
    "mode": {
      "default": "search",
      "description": "What to fetch: search a category + location, or fetch full business profiles from direct URLs.",
      "editor": "select",
      "enum": [
        "search",
        "detail"
      ],
      "enumTitles": [
        "Search by category & location",
        "Fetch business profiles by URL"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "openNowOnly": {
      "default": false,
      "description": "Only return businesses that are currently open, computed from each business's opening hours in the Europe/Lisbon timezone (mode=search). Businesses with no published hours are still included.",
      "prefill": false,
      "title": "Open now only",
      "type": "boolean"
    },
    "sortBy": {
      "default": "ranked",
      "description": "How to order search results (mode=search).",
      "editor": "select",
      "enum": [
        "ranked",
        "popular"
      ],
      "enumTitles": [
        "Classificacao (default ranking)",
        "Mais Popular (most popular)"
      ],
      "prefill": "ranked",
      "title": "Sort order",
      "type": "string"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "PaiPt Scraper Input",
  "type": "object"
}
