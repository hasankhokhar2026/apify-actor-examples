{
  "description": "Search pai.pt (Paginas Amarelas, Portugal's business directory) listings by category and location, or fetch full business profiles by direct URL.",
  "properties": {
    "businessUrls": {
      "default": [],
      "description": "Direct pai.pt business profile URLs to fetch, e.g. https://www.pai.pt/paginas/161409-restaurantes-pezarroz. Use the 'sourceUrl' field from search results.",
      "editor": "requestListSources",
      "items": {
        "properties": {
          "url": {
            "description": "pai.pt business profile URL.",
            "title": "URL",
            "type": "string"
          }
        },
        "type": "object"
      },
      "prefill": [],
      "title": "Business profile URLs (mode=detail)",
      "type": "array"
    },
    "category": {
      "default": "restaurantes",
      "description": "Business category to search for. Pick a common category from the list, or choose 'Custom category' and type your own slug below (mode=search).",
      "editor": "select",
      "enum": [
        "custom",
        "restaurantes",
        "advogados",
        "dentistas",
        "cabeleireiros",
        "hoteis",
        "eletricistas",
        "pintores",
        "imobiliarias",
        "funerarias",
        "fisioterapeutas",
        "veterinarios",
        "farmacias",
        "limpezas",
        "mudancas",
        "padarias",
        "talhos",
        "ginasios",
        "clinicas-veterinarias",
        "arquitetos",
        "notarios",
        "seguros",
        "psicologos",
        "pastelarias",
        "cafes",
        "bares",
        "pizzarias",
        "escolas",
        "creches",
        "serralharias",
        "construcao-civil",
        "engenheiros"
      ],
      "enumTitles": [
        "Custom category (type slug below)",
        "Restaurantes (Restaurants)",
        "Advogados (Lawyers)",
        "Dentistas (Dentists)",
        "Cabeleireiros (Hairdressers)",
        "Hoteis (Hotels)",
        "Eletricistas (Electricians)",
        "Pintores (Painters)",
        "Imobiliarias (Real estate agencies)",
        "Funerarias (Funeral homes)",
        "Fisioterapeutas (Physiotherapists)",
        "Veterinarios (Veterinarians)",
        "Farmacias (Pharmacies)",
        "Limpezas (Cleaning services)",
        "Mudancas (Moving companies)",
        "Padarias (Bakeries)",
        "Talhos (Butchers)",
        "Ginasios (Gyms)",
        "Clinicas veterinarias (Veterinary clinics)",
        "Arquitetos (Architects)",
        "Notarios (Notaries)",
        "Seguros (Insurance)",
        "Psicologos (Psychologists)",
        "Pastelarias (Pastry shops)",
        "Cafes",
        "Bares (Bars)",
        "Pizzarias (Pizzerias)",
        "Escolas (Schools)",
        "Creches (Daycare centers)",
        "Serralharias (Locksmiths / metalworks)",
        "Construcao civil (Construction)",
        "Engenheiros (Engineers)"
      ],
      "prefill": "restaurantes",
      "title": "Category",
      "type": "string"
    },
    "customCategory": {
      "description": "Free-text pai.pt category URL slug not in the curated list above, e.g. 'canalizadores' or 'oficinas-auto' (mode=search). Takes priority over 'Category' when set.",
      "editor": "textfield",
      "title": "Custom category (overrides selection above)",
      "type": "string"
    },
    "customLocation": {
      "description": "Free-text pai.pt location URL slug not in the curated list above, e.g. 'vila-franca-de-xira' or 'peniche' (mode=search). Takes priority over 'Location' when set.",
      "editor": "textfield",
      "title": "Custom location (overrides selection above)",
      "type": "string"
    },
    "fetchDetails": {
      "default": true,
      "description": "For each search result, also visit its business profile page to collect address, phone, email, website, coordinates, and full category/tag lists. Recommended -- disable only for a faster, name-only preview scan (mode=search).",
      "prefill": true,
      "title": "Fetch full business profiles",
      "type": "boolean"
    },
    "location": {
      "default": "",
      "description": "Portuguese city or concelho to search in. Leave as 'Any location (nationwide)' to search the category across all of Portugal (mode=search).",
      "editor": "select",
      "enum": [
        "",
        "custom",
        "lisboa",
        "porto",
        "coimbra",
        "braga",
        "faro",
