      "type": "string"
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on emitted records. Pagination continues until this cap or the last page. API page size is fixed at 20.",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "maxPrice": {
      "description": "Client-side: drop records with a price above this in the selected currency. Records with no price pass through.",
      "maximum": 100000,
      "minimum": 0,
      "title": "Max price",
      "type": "integer"
    },
    "maxRating": {
      "description": "Client-side: drop records rated above this (1-5). Records with no rating pass through.",
      "maximum": 5,
      "minimum": 1,
      "title": "Max rating",
      "type": "integer"
    },
    "minPrice": {
      "description": "Client-side: drop records with a price below this in the selected currency. Records with no price pass through.",
      "maximum": 100000,
      "minimum": 0,
      "title": "Min price",
      "type": "integer"
    },
    "minRating": {
      "description": "Client-side: drop records rated below this (1-5). Records with no rating pass through.",
      "maximum": 5,
      "minimum": 1,
      "title": "Min rating",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to fetch.",
      "editor": "select",
      "enum": [
        "search",
        "browseByCity",
        "browseByCategory",
        "byUrl",
        "byId"
      ],
      "enumTitles": [
        "Search experiences",
        "Browse all venues in a city",
        "Browse a category in a city",
        "Fetch specific venue / product / listing URLs",
        "Fetch venue and product IDs"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "productIds": {
      "default": [],
      "description": "Numeric Tiqets product/package IDs, e.g. 973980. Resolved through the public product redirect route; the product sitemap is a fallback.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Product IDs (mode=byId)",
      "type": "array"
    },
    "proxyConfiguration": {
      "description": "Optional user-supplied proxy. No account, user cookies or API key is required. Direct requests are tried first; free Apify Proxy is used only if they are blocked.",
      "editor": "proxy",
      "title": "Proxy configuration (optional)",
      "type": "object"
    },
    "searchQueries": {
      "default": [],
      "description": "One or more free-text queries (mode=search). Every query is paginated to `maxItems`; duplicate products are removed.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Search queries",
      "type": "array"
    },
    "searchQuery": {
      "default": "eiffel tower",
      "description": "Free-text query, e.g. `eiffel tower`, `louvre`, `hop on hop off bus` (mode=search). Kept for backward compatibility; use `searchQueries` for multiple queries.",
      "editor": "textfield",
      "prefill": "eiffel tower",
      "title": "Search query",
      "type": "string"
    },
    "sortType": {
      "default": "popularity",
      "description": "Verified server-side sort for city/category browse. Search ignores sort parameters. Price sorting is not supported by the API.",
      "editor": "select",
      "enum": [
        "popularity",
        "rating"
      ],
      "enumTitles": [
        "Popularity",
        "Rating"
      ],
      "prefill": "popularity",
      "title": "Sort (browse modes)",
      "type": "string"
    },
    "startUrls": {
      "default": [],
      "description": "Venue (`...-l123/`), product (`...-p456/`), city (`...-c66746/`) or category (`.../museums-t2968/`) URLs. The input locale is preserved.",
      "editor": "requestListSources",
      "prefill": [],
      "title": "Tiqets URLs (mode=byUrl)",
      "type": "array"
    },
    "topRatedOnly": {
      "default": false,
      "description": "Client-side: only emit records rated 4.5 or higher.",
      "prefill": false,
      "title": "Top-rated only",
      "type": "boolean"
    },
    "venueIds": {
      "default": [],
      "description": "Numeric Tiqets venue IDs, e.g. `144586`. Resolved through `/{locale}/tickets-l{id}/` redirects.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Venue IDs (mode=byId)",
      "type": "array"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Tiqets Attraction & Ticket Price Finder Input",
  "type": "object"
}
