      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Experience tag IDs",
      "type": "array"
    },
    "hasDiscount": {
      "default": false,
      "description": "Client-side discount filter. The search API ignores the query when hasDiscount is sent, so the actor keeps the query and filters results locally.",
      "prefill": false,
      "title": "Discounted only",
      "type": "boolean"
    },
    "includeAvailability": {
      "default": false,
      "description": "Fetch optional dates/timeslots for product and package records. Adds one dates request plus one timeslots request per available date; omitted when the API returns none.",
      "prefill": false,
      "title": "Include availability",
      "type": "boolean"
    },
    "includeExtraVenues": {
      "default": true,
      "description": "Only used by the SSR fallback: also emit venue links found outside the main listing. API results already include every venue.",
      "prefill": true,
      "title": "Include extra venue links",
      "type": "boolean"
    },
    "language": {
      "default": "en",
      "description": "Site language. 17 real sitemap locales; ar/tr redirect to English and are not offered.",
      "editor": "select",
      "enum": [
        "ca",
        "cs",
        "da",
        "de",
        "el",
        "en",
        "es",
        "fr",
        "it",
