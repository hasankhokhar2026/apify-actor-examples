        "Frozen Pizza",
        "Ice Cream",
        "Frozen Vegetables",
        "Fresh Fish",
        "Frozen Fish",
        "Lobster & Crab",
        "Shrimp",
        "Salmon",
        "Bakery Desserts",
        "Artisan Breads"
      ],
      "prefill": "milk",
      "title": "Category",
      "type": "string"
    },
    "dealsCollection": {
      "default": "seasonal_entertaining",
      "description": "Evergreen featured/discovery collection to browse (mode=deals). Wegmans does not publish clearance discount data publicly, so this surfaces its curated featured product sets instead.",
      "editor": "select",
      "enum": [
        "seasonal_entertaining",
        "gold_pan_meals",
        "gluten_free",
        "active_nutrition"
      ],
      "enumTitles": [
        "Seasonal Entertaining",
        "Gold Pan Meals",
        "Living Gluten Free",
        "Active & Sports Nutrition"
      ],
      "prefill": "seasonal_entertaining",
      "title": "Featured collection",
      "type": "string"
    },
    "maxItems": {
      "default": 30,
      "description": "Hard cap on emitted records.",
      "maximum": 150,
      "minimum": 1,
      "prefill": 30,
      "title": "Max items",
      "type": "integer"
    },
    "maxPrice": {
      "description": "Drop products pricier than this.",
      "maximum": 1000,
      "minimum": 0,
      "title": "Max price (USD)",
      "type": "number"
    },
    "minPrice": {
      "description": "Drop products cheaper than this.",
      "maximum": 1000,
      "minimum": 0,
      "title": "Min price (USD)",
      "type": "number"
    },
    "minRating": {
      "description": "Drop products with a lower average star rating.",
      "maximum": 5,
      "minimum": 0,
      "title": "Min rating (0-5)",
      "type": "number"
    },
    "mode": {
      "default": "search",
      "description": "What to fetch.",
      "editor": "select",
      "enum": [
        "search",
        "byCategory",
        "deals"
      ],
      "enumTitles": [
        "Search by keyword",
        "Browse by category",
        "Featured collections"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "searchQuery": {
      "default": "milk",
      "description": "Free-text product keyword (mode=search), e.g. `milk`, `chicken breast`, `ice cream`.",
      "editor": "textfield",
      "prefill": "milk",
      "title": "Search query",
      "type": "string"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Wegmans Grocery Scraper Input",
  "type": "object"
}
