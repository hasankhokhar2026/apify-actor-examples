{
  "description": "Search viagogo events, browse by city/category, or fetch event details by URL.",
  "properties": {
    "availableOnly": {
      "default": false,
      "description": "Only emit events that currently have active ticket listings.",
      "prefill": false,
      "title": "Available listings only",
      "type": "boolean"
    },
    "category": {
      "description": "Category filter / browse axis (21 categories with upstream category IDs).",
      "editor": "select",
      "enum": [
        "sports",
        "concerts",
        "theater",
        "baseball",
        "football",
        "basketball",
        "hockey",
        "soccer",
        "golf",
