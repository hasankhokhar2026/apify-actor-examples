        "Sao Paulo",
        "Dubai",
        "Singapore"
      ],
      "prefill": "london",
      "title": "City",
      "type": "string"
    },
    "countryCode": {
      "description": "Only emit events in this country (ISO 3166-1 alpha-2, e.g. `US`, `GB`, `DE`).",
      "editor": "textfield",
      "title": "Country filter (ISO code)",
      "type": "string"
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on emitted records.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 50,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to fetch.",
      "editor": "select",
      "enum": [
        "search",
        "browseByCity",
        "browseByCategory",
        "byUrl"
      ],
      "enumTitles": [
        "Search events",
        "Browse events by city",
        "Browse events by category",
        "Fetch events by URL"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "proxyConfiguration": {
      "description": "Optional Apify proxy. The actor fetches directly first; only on HTTP 403/429 does it retry through the proxy.",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": false
      },
      "title": "Proxy configuration",
      "type": "object"
    },
    "publicPurchaseOnly": {
      "default": false,
      "description": "Only emit events that allow public purchase.",
      "prefill": false,
      "title": "Public purchase only",
      "type": "boolean"
    },
    "searchQuery": {
      "default": "taylor swift",
      "description": "Free-text query (mode=search), e.g. `taylor swift`, `nfl`, `coldplay`.",
      "editor": "textfield",
      "prefill": "taylor swift",
      "title": "Search query",
      "type": "string"
    },
    "startUrls": {
      "default": [],
      "description": "viagogo event URLs, e.g. `https://www.viagogo.com/E-161561961`.",
      "editor": "stringList",
      "prefill": [],
      "title": "Event URLs (mode=byUrl)",
      "type": "array"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Viagogo Scraper Input",
  "type": "object"
}
