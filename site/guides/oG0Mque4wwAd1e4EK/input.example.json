  "quality": 85,
  "scrollStepPx": 250,
  "scrollToBottom": false,
  "urls": [
    {
      "url": "https://www.apify.com/"
    }
  ],
  "viewportHeight": 1080,
  "viewportWidth": 1280,
  "waitForFonts": true,
  "waitForImages": false,
  "waitUntil": "domcontentloaded",
  "waitUntilNetworkIdleAfterScroll": false,
