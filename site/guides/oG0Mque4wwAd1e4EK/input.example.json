{
  "colorScheme": "no-preference",
  "delay": 0,
  "delayAfterScrolling": 0,
  "device": "custom",
  "deviceScaleFactor": 1,
  "format": "png",
  "fullPage": true,
  "hideFixedElements": false,
  "locale": "en-US",
  "maxConcurrency": 1,
  "maxPageHeight": 0,
  "maxRetries": 0,
  "maxScrollSteps": 400,
  "navigationTimeoutSecs": 60,
