      "prefill": "",
      "title": "Default phone country",
      "type": "string"
    },
    "includeNamedEmails": {
      "default": true,
      "description": "Include personal addresses such as jane.smith@company.com. When off, only role addresses such as info@, sales@ and support@ are kept.",
      "prefill": true,
      "title": "Include Personal Emails",
      "type": "boolean"
    },
    "maxConcurrency": {
      "default": 5,
      "description": "How many pages of the same website may be fetched in parallel.",
      "editor": "number",
      "maximum": 20,
      "minimum": 1,
      "prefill": 5,
      "title": "Page Concurrency Per Site",
      "type": "integer"
    },
    "maxPagesPerSite": {
      "default": 20,
      "description": "Maximum number of pages to fetch per website. Contact, about, team and imprint pages are prioritised.",
      "editor": "number",
      "maximum": 200,
      "minimum": 1,
      "prefill": 5,
      "title": "Max Pages Per Site",
      "type": "integer"
    },
    "maxSitesConcurrency": {
      "default": 3,
      "description": "How many websites are scanned in parallel. Lower this if you hit rate limits.",
      "editor": "number",
      "maximum": 10,
      "minimum": 1,
      "prefill": 3,
      "title": "Website Concurrency",
      "type": "integer"
    },
    "onlyWithContacts": {
      "default": false,
      "description": "Drop records for websites where no email, phone, social profile or contact form was found.",
      "prefill": false,
      "title": "Only Output Sites With Contacts",
      "type": "boolean"
    },
    "renderFallback": {
      "default": true,
      "description": "If plain HTML contains no email or phone, render up to two pages in a headless browser to capture contacts loaded by JavaScript.",
      "prefill": true,
      "title": "Render JavaScript Pages When Needed",
      "type": "boolean"
    },
    "requestTimeoutSecs": {
      "default": 15,
      "description": "Maximum time to wait for one page before trying the next proxy tier.",
      "editor": "number",
      "maximum": 60,
      "minimum": 5,
      "prefill": 15,
      "title": "Request Timeout (seconds)",
      "type": "integer"
    },
    "respectRobotsTxt": {
      "default": true,
      "description": "Skip pages that the website's robots.txt disallows. Turn this off only when you own the site or have permission to crawl it.",
      "prefill": true,
      "title": "Respect robots.txt",
      "type": "boolean"
    },
    "smartPrioritise": {
      "default": true,
      "description": "Try common contact, about, team, imprint and support paths first, and queue contact-like links ahead of other internal links.",
      "prefill": true,
      "title": "Smart Page Prioritisation",
      "type": "boolean"
    },
    "urls": {
      "description": "Websites to scan for public contact details. You can paste full URLs or bare domains; duplicates are removed.",
      "editor": "stringList",
      "prefill": [
        "https://apify.com"
      ],
      "title": "Website URLs",
      "type": "array"
    },
    "useProxy": {
      "default": false,
      "description": "Start with the Apify proxy ladder instead of trying direct requests first. The actor always retries blocked requests through the proxy ladder automatically.",
      "prefill": false,
      "title": "Use Proxy First",
      "type": "boolean"
    },
    "useSitemap": {
      "default": true,
      "description": "Read sitemap.xml and robots.txt sitemap entries to find contact and about pages that are not linked from the homepage.",
      "prefill": true,
      "title": "Discover Pages From Sitemap",
      "type": "boolean"
    }
  },
  "required": [
    "urls"
  ],
  "schemaVersion": 1,
  "title": "Website Contact Finder Input",
  "type": "object"
}
