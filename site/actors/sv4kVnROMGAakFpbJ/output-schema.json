{
  "actorOutputSchemaVersion": 1,
  "description": "One row per place in search/details modes and one row per review in reviews mode. Empty fields are omitted at every depth. Every record carries recordType, sourceUrl and scrapedAt.",
  "properties": {
    "address": {
      "description": "Full address",
      "template": "{{address}}",
      "title": "Address",
      "type": "string"
    },
    "amenities": {
      "description": "Hotel amenities",
      "template": "{{amenities}}",
      "title": "Amenities",
      "type": "string"
    },
    "author": {
      "description": "Reviewer display name",
      "template": "{{author}}",
      "title": "Author",
      "type": "string"
    },
    "authorLocation": {
      "description": "Reviewer hometown when published",
      "template": "{{authorLocation}}",
      "title": "Author location",
      "type": "string"
    },
    "cuisine": {
      "description": "Restaurant cuisines",
      "template": "{{cuisine}}",
      "title": "Cuisine",
      "type": "string"
    },
    "date": {
      "description": "Review submission timestamp",
      "template": "{{date}}",
      "title": "Review date",
      "type": "string"
    },
    "email": {
      "description": "Published email",
      "template": "{{email}}",
      "title": "Email",
      "type": "string"
    },
    "helpfulVotes": {
      "description": "Helpful votes on the review",
      "template": "{{helpfulVotes}}",
      "title": "Helpful votes",
      "type": "string"
    },
    "id": {
      "description": "Place ID for place rows, review ID for review rows",
      "template": "{{id}}",
      "title": "ID",
      "type": "string"
    },
    "language": {
      "description": "Review language tag",
      "template": "{{language}}",
      "title": "Review language",
      "type": "string"
    },
    "lat": {
      "description": "Latitude",
      "template": "{{lat}}",
      "title": "Latitude",
      "type": "string"
    },
    "lng": {
      "description": "Longitude",
      "template": "{{lng}}",
      "title": "Longitude",
      "type": "string"
    },
    "name": {
      "description": "Place name",
      "template": "{{name}}",
      "title": "Place name",
      "type": "string"
    },
    "phone": {
      "description": "Phone number",
      "template": "{{phone}}",
      "title": "Phone",
      "type": "string"
    },
    "photos": {
      "description": "Place photo URLs",
      "template": "{{photos}}",
      "title": "Photos",
      "type": "string"
    },
    "placeId": {
      "description": "Place ID for review rows",
      "template": "{{placeId}}",
      "title": "Place ID",
      "type": "string"
    },
    "priceRange": {
      "description": "Price range or price level published by Tripadvisor",
      "template": "{{priceRange}}",
      "title": "Price range",
      "type": "string"
    },
    "ranking": {
      "description": "Tripadvisor ranking text, for example #13 of 588 hotels in New York City",
      "template": "{{ranking}}",
      "title": "Ranking",
      "type": "string"
    },
    "rating": {
      "description": "Bubble rating, 0-5",
      "template": "{{rating}}",
      "title": "Rating",
      "type": "string"
    },
    "recordType": {
      "description": "place or review",
      "template": "{{recordType}}",
      "title": "Record type",
      "type": "string"
    },
    "reviewCount": {
      "description": "Total number of reviews for the place",
      "template": "{{reviewCount}}",
      "title": "Review count",
      "type": "string"
    },
    "scrapedAt": {
      "description": "ISO timestamp of the run",
      "template": "{{scrapedAt}}",
      "title": "Scraped at",
      "type": "string"
    },
    "sourceUrl": {
      "description": "Tripadvisor page the record came from",
      "template": "{{sourceUrl}}",
      "title": "Source URL",
      "type": "string"
    },
    "text": {
      "description": "Review body",
      "template": "{{text}}",
      "title": "Review text",
      "type": "string"
    },
    "title": {
      "description": "Review title",
      "template": "{{title}}",
      "title": "Review title",
      "type": "string"
    },
    "tripType": {
      "description": "Traveler type reported by the reviewer",
      "template": "{{tripType}}",
      "title": "Trip type",
      "type": "string"
    },
    "type": {
      "description": "hotel, restaurant or attraction",
      "template": "{{type}}",
      "title": "Place type",
      "type": "string"
    },
    "url": {
      "description": "Canonical Tripadvisor place page",
      "template": "{{url}}",
      "title": "Place URL",
      "type": "string"
    }
  },
  "required": [
    "recordType",
    "sourceUrl",
    "scrapedAt",
    "id"
  ],
  "title": "Tripadvisor Place and Review Scraper output",
  "type": "object"
}
