{
  "description": "Search Farfetch luxury fashion products by keyword, brand, gender, or sale items across regional storefronts.",
  "properties": {
    "brand": {
      "description": "Brand name to filter by (e.g. 'gucci', 'prada', 'balenciaga').",
      "editor": "textfield",
      "title": "Brand (mode=searchByBrand)",
      "type": "string"
    },
    "gender": {
      "default": "",
      "description": "Filter by gender. When omitted, listing modes use the women's storefront.",
      "editor": "select",
      "enum": [
        "",
        "women",
        "men",
        "kids"
      ],
      "enumTitles": [
        "All genders",
        "Women",
        "Men",
        "Kids"
      ],
      "prefill": "",
      "title": "Gender",
      "type": "string"
    },
    "keyword": {
      "default": "Gucci bag",
      "description": "Product keyword to search for (e.g. 'Gucci bag', 'Prada shoes').",
      "editor": "textfield",
      "prefill": "Gucci bag",
      "title": "Search keyword",
      "type": "string"
    },
    "locale": {
      "default": "nz",
      "description": "Regional Farfetch storefront. Prices and availability are local to the selected market.",
      "editor": "select",
      "enum": [
        "nz",
        "uk",
        "fr",
        "de",
        "it",
        "es",
        "ie",
        "hk",
        "mo",
        "cn",
        "sg",
        "jp",
        "kr",
        "au",
        "ca",
        "ae",
        "tw"
      ],
      "enumTitles": [
        "New Zealand (USD)",
        "United Kingdom (GBP)",
        "France (EUR)",
        "Germany (EUR)",
        "Italy (EUR)",
        "Spain (EUR)",
        "Ireland (EUR)",
        "Hong Kong (HKD)",
        "Macau (HKD)",
        "Mainland China (CNY)",
        "Singapore (SGD)",
        "Japan (JPY)",
        "South Korea (KRW)",
        "Australia (AUD)",
        "Canada (CAD)",
        "United Arab Emirates (AED)",
        "Taiwan (TWD)"
      ],
      "prefill": "nz",
      "title": "Storefront / currency",
      "type": "string"
    },
    "maxItems": {
      "default": 20,
      "description": "Maximum number of products to return.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to browse on Farfetch.",
      "editor": "select",
      "enum": [
        "search",
        "searchByBrand",
        "newIn",
        "saleItems",
        "productDetails"
      ],
      "enumTitles": [
        "Search by keyword",
        "Browse by brand",
        "New arrivals",
        "Sale items",
        "Get product details by URLs"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "productUrls": {
      "default": [],
      "description": "Farfetch product page URLs to scrape. Both farfetch.com and farfetch.cn URLs are accepted and converted to the selected storefront.",
      "editor": "stringList",
      "prefill": [],
      "title": "Product URLs (mode=productDetails)",
      "type": "array"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Farfetch Scraper Input",
  "type": "object"
}
