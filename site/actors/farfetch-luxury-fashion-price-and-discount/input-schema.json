      "maximum": 2500,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to browse on Farfetch.",
      "editor": "select",
      "enum": [
        "search",
        "searchByBrand",
        "category",
        "newIn",
        "saleItems",
        "listingUrls",
        "productDetails"
      ],
      "enumTitles": [
        "Search by keyword",
        "Browse by brand",
        "Browse a category",
        "New arrivals",
        "Sale items",
        "Scrape listing URLs",
        "Get product details by URLs"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "priceMax": {
      "description": "Highest price to include, in the selected storefront's currency. Leave empty for no maximum.",
      "maximum": 1000000,
      "minimum": 0,
      "title": "Maximum price",
      "type": "integer"
    },
    "priceMin": {
      "description": "Lowest price to include, in the selected storefront's currency. Leave empty for no minimum.",
      "maximum": 1000000,
      "minimum": 0,
      "title": "Minimum price",
      "type": "integer"
    },
    "productUrls": {
      "default": [],
      "description": "Farfetch product page URLs to scrape. Both farfetch.com and farfetch.cn URLs are accepted and converted to the selected storefront.",
      "editor": "stringList",
      "prefill": [],
      "title": "Product URLs (mode=productDetails)",
      "type": "array"
    },
    "sortBy": {
      "default": "recommended",
