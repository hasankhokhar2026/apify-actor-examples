    "maxEmployees": {
      "description": "Drop companies whose published employee count is above this value. Companies without a published count are kept.",
      "maximum": 1000000,
      "minimum": 0,
      "title": "Maximum employees",
      "type": "integer"
    },
    "maxItems": {
      "default": 100,
      "description": "Hard cap on company records returned. Large runs with includeDetails on are slow because each company needs a detail request; use includeDetails false for bulk listing. The actor warns if its page safety cap is reached before maxItems.",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 1,
      "title": "Max companies",
      "type": "integer"
    },
    "minEmployees": {
      "description": "Drop companies whose published employee count is below this value. Companies without a published count are kept.",
      "maximum": 1000000,
      "minimum": 0,
      "title": "Minimum employees",
      "type": "integer"
    },
