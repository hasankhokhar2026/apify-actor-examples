{
  "description": "Browse BuiltIn's tech-company directory by location, industry, technology, company size and work arrangement, search companies by name, or look up specific companies. Returns headcount, industries, tech stack, offices, benefits, hiring status and open-jobs signals.",
  "properties": {
    "companySize": {
      "default": "",
      "description": "Filter companies by employee-count band. Browse mode only; search/byCompany ignore it with a warning.",
      "editor": "select",
      "enum": [
        "",
        "1-10",
        "11-50",
        "51-200",
        "201-500",
        "501-1000",
        "1000"
      ],
      "enumTitles": [
        "All sizes",
        "1-10 employees",
        "11-50 employees",
        "51-200 employees",
        "201-500 employees",
        "501-1000 employees",
        "1000+ employees"
      ],
      "prefill": "",
      "title": "Company size",
      "type": "string"
    },
    "companyUrls": {
      "default": [],
      "description": "BuiltIn company URLs (e.g. `https://builtin.com/company/stripe`), slugs (`stripe`) or exact company names (`Stripe`). Names are resolved through BuiltIn's company search; only an exact slug or exact name match is accepted. Unresolved inputs are emitted as error rows with `input` and `error` fields.",
      "editor": "stringList",
      "prefill": [],
      "title": "Company names, slugs or URLs (mode=byCompany)",
      "type": "array"
    },
    "hiringOnly": {
      "default": false,
      "description": "Only return companies with at least one open job on BuiltIn. Browse mode only; search/byCompany ignore it with a warning.",
      "prefill": false,
      "title": "Hiring companies only",
      "type": "boolean"
    },
    "includeBenefits": {
      "default": false,
      "description": "Also read each company's benefits page and return the full list of published perks. Adds one request per company.",
      "prefill": false,
      "title": "Include detailed benefits",
      "type": "boolean"
    },
    "includeDetails": {
      "default": true,
      "description": "Fetch each company's full BuiltIn record for its tech stack, offices, headquarters, founding year, website and benefits count. If a detail record is missing or has no tech stack, the actor falls back to the company profile page. Turn off for the fastest listing-only run.",
      "prefill": false,
      "title": "Include company details",
      "type": "boolean"
    },
    "includeProfile": {
      "default": false,
      "description": "Also read each company profile for recent jobs, typical on-site time and product/tech headcount. Adds one request per company.",
      "prefill": false,
      "title": "Include profile extras",
      "type": "boolean"
    },
