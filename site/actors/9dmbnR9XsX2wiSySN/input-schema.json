    "dateFrom": {
      "description": "Keep ads whose observed flight overlaps this window. An ad is kept when firstShown <= dateTo and lastShown >= dateFrom, so ads that started earlier but were still running inside the window are included.",
      "editor": "datepicker",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "title": "Shown during window: from (YYYY-MM-DD)",
      "type": "string"
    },
    "dateTo": {
      "description": "Keep ads whose observed flight overlaps this window (inclusive). Works together with dateFrom and is no longer compared only against firstShown.",
      "editor": "datepicker",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "title": "Shown during window: to (YYYY-MM-DD)",
      "type": "string"
    },
    "format": {
      "default": "all",
      "description": "Server-side creative format filter. TEXT, IMAGE and VIDEO map to Google's verified format codes 1, 2 and 3.",
      "editor": "select",
      "enum": [
        "all",
        "text",
        "image",
        "video"
      ],
      "enumTitles": [
        "All formats",
        "Text",
        "Image",
        "Video"
      ],
      "prefill": "all",
      "title": "Ad format",
      "type": "string"
    },
    "includeVideoDetails": {
      "default": false,
      "description": "Fetch GetCreativeById for every creative to enrich last-shown dates, served regions and preview assets. Video IDs are resolved from previews even when this is off.",
      "prefill": false,
      "title": "Include creative detail enrichment",
      "type": "boolean"
    },
    "maxAdsPerAdvertiser": {
      "default": 100,
      "description": "Cursor-pagination cap per advertiser or domain, applied before the global maxItems cap.",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max ads per advertiser",
      "type": "integer"
    },
    "maxAdvertisersPerTerm": {
      "default": 5,
      "description": "Maximum advertiser matches (and domain suggestions) to scrape per keyword (when searchTerms is used).",
      "maximum": 50,
      "minimum": 1,
      "prefill": 5,
      "title": "Max advertisers per search term",
      "type": "integer"
    },
    "maxConcurrency": {
      "default": 2,
      "description": "Advertisers scraped in parallel. Higher is faster but increases rate-limit risk.",
      "maximum": 5,
      "minimum": 1,
      "prefill": 2,
      "title": "Max concurrency",
      "type": "integer"
    },
    "maxItems": {
      "default": 100,
      "description": "Hard cap on total ad records returned (1-5000). Advertiser and run-summary records do not count toward this cap.",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "monitorStoreName": {
      "default": "youtube-ads-monitor",
      "description": "Key-value store that remembers seen ad IDs for monitor mode (default: youtube-ads-monitor).",
      "editor": "textfield",
      "prefill": "youtube-ads-monitor",
      "title": "Monitor store name",
      "type": "string"
    },
    "onlyNew": {
      "default": false,
      "description": "Output only ad IDs not seen in earlier runs and mark them isNew: true. Reuse the same monitorStoreName for the same competitor list. The first run creates the baseline.",
      "prefill": false,
      "title": "Only new ads (monitor mode)",
      "type": "boolean"
    },
    "outputFormat": {
      "default": "json",
      "description": "Dataset always receives JSON records. Additionally export results as CSV, Excel, or HTML in the key-value store (OUTPUT.csv / OUTPUT.xlsx / OUTPUT.html).",
      "editor": "select",
      "enum": [
        "json",
        "csv",
        "excel",
        "html"
      ],
      "enumTitles": [
        "JSON (dataset only)",
        "CSV (OUTPUT.csv)",
        "Excel (OUTPUT.xlsx)",
        "HTML (OUTPUT.html)"
      ],
      "prefill": "json",
      "title": "Output format",
      "type": "string"
    },
    "proxyConfiguration": {
      "description": "Optional proxy. For moderate traffic no proxy is needed. Enable Apify proxy for high-volume scraping.",
      "editor": "proxy",
      "title": "Proxy Configuration",
      "type": "object"
    },
    "resolveVideoIds": {
      "default": true,
      "description": "Extract videoId, watch URL, thumbnail and duration from creative previews (ytimg/youtube URLs). Missing IDs are omitted, never fabricated. Turn off to save preview requests.",
      "prefill": false,
      "title": "Resolve YouTube video IDs from previews",
      "type": "boolean"
    },
    "searchTerms": {
      "description": "Keywords or domains used to discover advertisers and domains, then scrape their YouTube ads (e.g. 'electric car', 'nike.com'). Keyword searches also use domain suggestions returned by Google.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [
        "nike.com"
      ],
      "title": "Search Terms (keywords or domains)",
      "type": "array"
    }
  },
  "schemaVersion": 1,
  "title": "YouTube Ads Scraper Input",
  "type": "object"
}
