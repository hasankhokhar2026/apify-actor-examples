{
  "description": "Scrape official NCAA team and player leaderboards, ranking polls, conference standings, the school directory, schedules/scores, game details, and championship history.",
  "properties": {
    "conference": {
      "default": "all",
      "description": "(mode=standings or schedules) Optional conference filter. Standings are fetched from the chosen conference's own page; schedules keep games involving a team from that conference. Not every conference is offered for every sport. When set, records without a published conference are excluded.",
      "editor": "select",
      "enum": [
        "all",
        "acc",
        "america-east",
        "american",
        "asun",
        "atlantic-10",
        "big-12",
        "big-east",
        "big-sky",
        "big-south",
        "big-ten",
        "big-west",
        "caa",
        "cusa",
        "fbs-independent",
        "fcs-independent",
        "horizon",
        "ivy-league",
        "mac",
        "meac",
        "metro",
        "mountain-west",
        "mvc",
        "mvfc",
        "nec",
        "ovc",
        "pac-12",
        "patriot",
        "pioneer",
        "sec",
        "socon",
        "southland",
        "summit-league",
        "sun-belt",
        "swac",
        "uac-",
        "wcc"
      ],
      "enumTitles": [
        "All conferences",
        "ATLANTIC COAST CONFERENCE",
        "AMERICA EAST CONFERENCE",
        "AMERICAN CONFERENCE",
        "ATLANTIC SUN CONFERENCE",
        "ATLANTIC 10 CONFERENCE",
        "BIG 12 CONFERENCE",
        "BIG EAST CONFERENCE",
        "BIG SKY CONFERENCE",
        "BIG SOUTH CONFERENCE",
        "BIG TEN CONFERENCE",
        "BIG WEST CONFERENCE",
