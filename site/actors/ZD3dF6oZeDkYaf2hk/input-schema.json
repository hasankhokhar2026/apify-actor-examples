        "SOUTHWESTERN ATHLETIC CONF.",
        "UNITED ATHLETIC CONFERENCE",
        "WEST COAST CONFERENCE"
      ],
      "prefill": "all",
      "title": "Conference",
      "type": "string"
    },
    "division": {
      "default": "d1",
      "description": "NCAA competition division. Football uses FBS/FCS; men's volleyball and women's ice hockey use `nc` (National Collegiate) for polls and history. The actor maps women's ice hockey `nc` schedules to NCAA.com's d1 scoreboard page. Not every division is offered for every sport; an unsupported combination returns a clear status message instead of data.",
      "editor": "select",
      "enum": [
        "d1",
        "d2",
        "d3",
        "fbs",
        "fcs",
        "nc"
      ],
      "enumTitles": [
        "Division I",
        "Division II",
        "Division III",
        "FBS — Football Bowl Subdivision",
        "FCS — Football Championship Subdivision",
        "National Collegiate"
      ],
      "prefill": "d1",
      "title": "Division",
      "type": "string"
    },
    "finalOnly": {
      "default": false,
      "description": "(mode=schedules) Keep only games whose status is final. Records without a final status are excluded.",
      "prefill": false,
      "title": "Final games only",
      "type": "boolean"
    },
    "gameIds": {
      "default": [],
      "description": "(mode=gameDetail) NCAA game IDs or game-page URLs, e.g. `6649632` or `https://www.ncaa.com/game/6649632`.",
      "editor": "stringList",
      "prefill": [],
      "title": "Game IDs or URLs",
      "type": "array"
    },
    "includeBoxscore": {
      "default": true,
      "description": "(mode=gameDetail) Include team and player box-score blocks when NCAA.com publishes them.",
      "prefill": false,
      "title": "Include box score",
      "type": "boolean"
    },
    "includeGameDetails": {
      "default": false,
      "description": "(mode=schedules) Add venue, city/state, linescores, records, and hasBoxscore/hasPbp to each game. Adds one game-page request plus one game-detail request per record.",
      "prefill": false,
      "title": "Enrich schedules with game details",
      "type": "boolean"
    },
    "includePlayByPlay": {
      "default": false,
      "description": "(mode=gameDetail) Include the play-by-play timeline when NCAA.com publishes it. This can make each record large.",
      "prefill": false,
      "title": "Include play-by-play",
      "type": "boolean"
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on the number of records emitted in this run. Leaderboard modes are also capped at 2,000 source rows (40 pages); the actor emits a status message if that cap is reached before maxItems.",
      "maximum": 2000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "minGames": {
      "description": "(mode=teamStats or individualStats) Optional minimum games-played filter. Rows without a games-played column pass through.",
      "maximum": 500,
      "minimum": 0,
      "title": "Minimum games played",
      "type": "integer"
    },
    "mode": {
      "default": "teamStats",
      "description": "What to scrape from NCAA.com.",
      "editor": "select",
      "enum": [
        "teamStats",
        "individualStats",
        "rankings",
        "standings",
        "teams",
        "schedules",
        "gameDetail",
        "history"
      ],
      "enumTitles": [
        "Team statistical leaderboards",
        "Individual (player) statistical leaderboards",
        "National ranking polls",
        "Conference standings",
        "NCAA school directory",
        "Schedules and scores",
        "Game detail (venue, linescores, box score, play-by-play)",
        "Championship history"
      ],
      "prefill": "teamStats",
      "title": "Mode",
      "type": "string"
    },
    "playerName": {
      "description": "(mode=individualStats) Optional case-insensitive player-name filter, e.g. `Dybantsa`. Searches the rows of the selected player leaderboard.",
      "editor": "textfield",
      "title": "Player filter",
      "type": "string"
    },
