        "Dutch",
        "Portuguese",
        "Arabic",
        "Turkish",
        "Japanese",
        "Chinese",
        "Korean",
        "Russian",
        "Greek"
      ],
      "prefill": "en",
      "title": "Language",
      "type": "string"
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on emitted records.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 10,
      "title": "Max items",
      "type": "integer"
    },
    "maxPrice": {
      "description": "Drop attractions with a from-price above this (in the selected currency).",
      "maximum": 100000,
      "minimum": 0,
      "title": "Max price",
      "type": "integer"
    },
    "maxRating": {
      "description": "Drop attractions rated above this (1-5).",
      "maximum": 5,
      "minimum": 1,
      "title": "Max rating",
      "type": "integer"
    },
    "minPrice": {
      "description": "Drop attractions with a from-price below this (in the selected currency).",
      "maximum": 100000,
      "minimum": 0,
      "title": "Min price",
      "type": "integer"
    },
    "minRating": {
      "description": "Drop attractions rated below this (1-5).",
      "maximum": 5,
      "minimum": 1,
      "title": "Min rating",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to fetch.",
      "editor": "select",
      "enum": [
        "search",
        "browseByCity",
        "browseByCategory",
        "byUrl"
      ],
      "enumTitles": [
        "Search attractions & experiences",
        "Browse all things to do in a city",
        "Browse a category in a city",
        "Fetch specific venue / product URLs"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "proxyConfiguration": {
      "description": "Optional proxy (only used when Tiqets rate-limits direct requests).",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": true
      },
      "title": "Proxy configuration",
      "type": "object"
    },
    "searchQuery": {
      "default": "eiffel tower",
      "description": "Free-text query, e.g. `eiffel tower`, `louvre`, `hop on hop off bus` (mode=search).",
      "editor": "textfield",
      "prefill": "eiffel tower",
      "title": "Search query",
      "type": "string"
    },
    "startUrls": {
      "default": [],
      "description": "Tiqets venue (`...-tickets-l123/`) or product (`...-p456/`) URLs to scrape.",
      "editor": "requestListSources",
      "prefill": [],
      "title": "Tiqets URLs (mode=byUrl)",
      "type": "array"
    },
    "topRatedOnly": {
      "default": false,
      "description": "Only emit attractions rated 4.5 or higher.",
      "prefill": false,
      "title": "Top-rated only",
      "type": "boolean"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Tiqets Scraper Input",
  "type": "object"
}
