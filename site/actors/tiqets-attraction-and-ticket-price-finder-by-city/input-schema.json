      "default": true,
      "description": "Also emit venue records parsed from additional links on listing pages (name + URL only).",
      "prefill": true,
      "title": "Include extra venue links",
      "type": "boolean"
    },
    "language": {
      "default": "en",
      "description": "Site language / locale used for search suggestions.",
      "editor": "select",
      "enum": [
        "en",
        "fr",
        "de",
        "es",
        "it",
        "nl",
        "pt",
        "ar",
        "tr",
        "ja",
        "zh",
