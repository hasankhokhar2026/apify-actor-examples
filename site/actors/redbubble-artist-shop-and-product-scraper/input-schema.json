        "all-caps",
        "u-pin-button",
        "w-scarf",
        "u-socks",
        "u-tech-accessories",
        "u-case-laptop-sleeve",
        "all-totes",
        "u-bag-studiopouch"
      ],
      "enumTitles": [
        "All Departments",
        "All Clothing",
        "Dresses",
        "Sweatshirts & Hoodies",
        "T-Shirts",
        "Tank Tops",
        "All Kids & Babies",
        "Kids Pullover Hoodies",
        "Kids T-Shirt",
        "Short Sleeve Baby One-Pieces",
        "All Phone Cases",
        "iPhone Cases",
        "Samsung Cases",
        "All Stickers",
        "All Wall Art",
