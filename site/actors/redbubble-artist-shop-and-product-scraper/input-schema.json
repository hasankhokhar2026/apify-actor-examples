{
  "description": "Search Redbubble products by keyword, browse an artist's shop, or fetch full product detail from a product URL.",
  "properties": {
    "artistUsernames": {
      "default": [],
      "description": "Redbubble artist usernames, e.g. `blah707` (from redbubble.com/people/<username>/shop).",
      "editor": "stringList",
      "prefill": [],
      "title": "Artist usernames (mode=byArtist)",
      "type": "array"
    },
    "category": {
      "default": "all-departments",
      "description": "Restrict results to a Redbubble product category (mode=search and mode=byArtist).",
      "editor": "select",
      "enum": [
        "all-departments",
        "u-clothing",
        "w-dresses",
        "u-sweatshirts",
        "u-tees",
        "u-tanks",
        "kids-clothes",
