      "description": "Only include ads that started running on or before this date (YYYY-MM-DD). Best-effort; not yet confirmed to filter results server-side.",
      "editor": "datepicker",
      "title": "End Date",
      "type": "string"
    },
    "mediaType": {
      "default": "all",
      "description": "Filter by media type in the ad.",
      "editor": "select",
      "enum": [
        "all",
        "image",
        "video",
        "meme",
        "none"
      ],
      "enumTitles": [
        "All Media",
        "Image",
        "Video",
        "Meme",
        "No Media"
      ],
      "title": "Media Type",
      "type": "string"
    },
    "pageIds": {
      "description": "Facebook Page IDs to fetch all ads for a specific advertiser (mode=byPage). Each Page ID is searched separately, same as searchTerms.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Page IDs / Advertiser Search",
      "type": "array"
    },
    "resultsPerSearch": {
      "default": 50,
      "description": "Maximum number of ads to extract per search term.",
      "maximum": 500,
      "minimum": 1,
      "prefill": 3,
      "title": "Results Per Search Term",
      "type": "integer"
    },
    "searchTerms": {
      "description": "Keywords or page names to search for in the Facebook Ad Library. Each term will be searched separately.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [
        "coffee"
      ],
      "title": "Search Terms",
      "type": "array"
    },
    "sortBy": {
      "default": "relevance",
      "description": "Order results by relevance (Facebook's default) or by total impressions.",
      "editor": "select",
      "enum": [
        "relevance",
        "total_impressions"
      ],
      "enumTitles": [
        "Relevance (default)",
        "Total Impressions"
      ],
      "title": "Sort By",
      "type": "string"
    },
    "startDate": {
      "description": "Only include ads that started running on or after this date (YYYY-MM-DD). Best-effort; not yet confirmed to filter results server-side.",
      "editor": "datepicker",
      "title": "Start Date",
      "type": "string"
    }
  },
  "schemaVersion": 1,
  "title": "Facebook Ads Library Scraper Input",
  "type": "object"
}
