{
  "description": "Search and scrape Facebook Ad Library ads by keyword, advertiser Page ID, direct Ad ID, or \"Paid for by\" funding-entity name. No cookies or authentication required.",
  "properties": {
    "adActiveStatus": {
      "default": "active",
      "description": "Filter by ad active status.",
      "editor": "select",
      "enum": [
        "all",
        "active",
        "inactive"
      ],
      "enumTitles": [
        "All Ads",
        "Active Only",
        "Inactive Only"
      ],
      "title": "Ad Status",
      "type": "string"
    },
    "adIds": {
      "description": "Fetch specific ads directly by their Ad Library ID (bypasses keyword/page search entirely for these).",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Direct Ad IDs",
      "type": "array"
    },
    "adType": {
      "default": "all",
      "description": "Filter by ad category type.",
      "editor": "select",
      "enum": [
        "all",
        "political_and_issue_ads",
        "housing",
        "employment",
        "credit"
      ],
      "enumTitles": [
        "All Types",
        "Political & Issue Ads",
        "Housing",
        "Employment",
        "Credit"
      ],
      "title": "Ad Type",
      "type": "string"
    },
    "bylines": {
      "description": "Search by the funding entity/committee name shown as \"Paid for by\" on political and issue ads. Implemented as a keyword search filtered to ads whose byline matches, since Facebook's Ad Library does not support a dedicated URL-level byline filter.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Search by \"Paid for by\" name",
      "type": "array"
    },
    "contentLanguages": {
      "description": "2-letter ISO language codes to filter ad content language.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Ad Content Languages",
      "type": "array"
    },
    "cookies": {
      "description": "Cookies from a logged-in Facebook browser session, as Netscape cookie-file text or a JSON array. IMPORTANT: Facebook gates Ads Library search behind login on many residential IPs — supplying cookies makes search reliably return results (export with a browser cookie extension, e.g. 'Get cookies.txt LOCALLY'). Leave empty to search unauthenticated (works on a subset of IPs).",
      "editor": "textarea",
      "title": "Facebook cookies (recommended)",
      "type": "string"
    },
