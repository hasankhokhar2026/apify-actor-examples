    "maxVideosPerChannel": {
      "default": 50,
      "description": "Maximum number of videos to enumerate from each channel (mode=channel). 1-1,000.",
      "maximum": 1000,
      "minimum": 1,
      "title": "Max Videos per Channel",
      "type": "integer"
    },
    "maxVideosPerPlaylist": {
      "default": 50,
      "description": "Maximum number of videos to enumerate from each playlist (mode=playlist). 1-1,000.",
      "maximum": 1000,
      "minimum": 1,
      "title": "Max Videos per Playlist",
      "type": "integer"
    },
    "maxWhisperMinutes": {
      "description": "Leave unset for the legacy behavior (AI enabled with no length limit). Set to 0 explicitly to disable AI transcription. A positive value only sends videos of that length or shorter to AI. AI still requires Use Whisper AI fallback.",
      "maximum": 1440,
      "minimum": 0,
      "title": "Max AI Length (minutes)",
      "type": "integer"
    },
    "mode": {
      "default": "videos",
      "description": "What to scrape: specific videos, a channel's uploads, or a playlist.",
      "editor": "select",
      "enum": [
        "videos",
        "channel",
        "playlist"
      ],
      "enumTitles": [
        "Video URLs",
        "Channel uploads",
        "Playlist videos"
      ],
      "prefill": "videos",
      "title": "Mode",
      "type": "string"
    },
    "outputFormat": {
      "default": "full",
      "description": "How transcript data is included. 'full' = segments and full_text; 'text_only' = full_text only; 'segments_only' = segments only; 'srt' / 'vtt' = ready-to-use subtitle text derived from the segments.",
      "editor": "select",
      "enum": [
        "full",
        "text_only",
        "segments_only",
        "srt",
        "vtt"
      ],
      "enumTitles": [
        "Full (segments + text)",
        "Text Only (no segments array)",
        "Segments Only (no full_text)",
        "SRT subtitles",
        "WebVTT subtitles"
      ],
      "title": "Output Format",
      "type": "string"
    },
    "playlistUrls": {
      "description": "Playlist URLs or IDs (mode=playlist), e.g. https://www.youtube.com/playlist?list=PL... or PL.... Every video in the playlist is transcribed.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Playlist URLs",
      "type": "array"
    },
    "proxyCountry": {
      "default": "US",
      "description": "Country/region for the proxy IP. Useful if transcripts are geo-blocked in the default US region.",
