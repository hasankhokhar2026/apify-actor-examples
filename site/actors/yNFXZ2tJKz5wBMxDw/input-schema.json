      "sectionCaption": "Advanced",
      "title": "Proxy Country",
      "type": "string"
    },
    "useWhisper": {
      "default": true,
      "description": "When YouTube has no transcript (disabled captions, music-only, or blocked), download the audio and transcribe with Whisper AI (faster-whisper, CPU). Adds ~30-180 s per video. Enabled by default to guarantee transcript output even when YouTube captions are unavailable.",
      "editor": "checkbox",
      "prefill": true,
      "title": "Use Whisper AI fallback",
      "type": "boolean"
    },
    "videoUrls": {
      "description": "YouTube watch URLs, youtu.be short links, Shorts/embed URLs, or plain 11-character video IDs (mode=videos). Duplicate IDs are processed once.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [
        "https://www.youtube.com/watch?v=jNQXAC9IVRw"
      ],
      "title": "Video URLs",
      "type": "array"
    },
    "whisperModel": {
      "default": "base",
      "description": "Whisper model size to use when `useWhisper` is enabled. Larger = more accurate but slower and more RAM. 'base' is balanced.",
      "editor": "select",
      "enum": [
        "tiny",
        "base",
        "small",
        "medium",
        "large-v3-turbo"
      ],
      "enumTitles": [
        "Tiny (fastest, ~39 MB)",
        "Base (balanced, ~74 MB)",
        "Small (~244 MB)",
        "Medium (best quality/speed, ~769 MB)",
        "Large-v3-turbo (highest accuracy, ~800 MB)"
      ],
      "prefill": "tiny",
      "title": "Whisper Model",
      "type": "string"
    }
