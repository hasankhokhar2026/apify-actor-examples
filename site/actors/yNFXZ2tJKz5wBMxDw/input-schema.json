{
  "description": "Extract timestamped transcripts and rich metadata from YouTube videos, channels, and playlists, with optional AI transcription.",
  "properties": {
    "channelUrls": {
      "description": "Channel URLs or handles (mode=channel), e.g. https://www.youtube.com/@TED, https://www.youtube.com/channel/UC..., or @TED. Each channel's latest uploads are enumerated and every video is transcribed.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Channel URLs",
      "type": "array"
    },
    "includeAutoGenerated": {
      "default": true,
      "description": "Whether to include auto-generated captions when manual captions are not available.",
      "prefill": true,
      "title": "Include Auto-Generated Captions",
      "type": "boolean"
    },
    "includeWordTimings": {
      "default": false,
      "description": "Add a wordTimings array with word-level start/end times. Only auto-generated YouTube captions expose word timings; manual captions and AI transcripts do not.",
      "editor": "checkbox",
      "prefill": false,
      "title": "Include Word Timings",
      "type": "boolean"
    },
