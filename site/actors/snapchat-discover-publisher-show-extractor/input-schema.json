    "maxEpisodesPerPublisher": {
      "default": 100,
      "description": "(mode=byPublisher with includeEpisodes) Maximum episodes collected across all seasons of one publisher.",
      "maximum": 2000,
      "minimum": 1,
      "prefill": 10,
      "title": "Maximum episodes per publisher",
      "type": "integer"
    },
    "maxStories": {
      "default": 50,
      "description": "Maximum dataset records this run may push. In Discover mode this counts stories; in the other modes it counts publisher or episode records. Nested episode lists are not counted separately.",
      "maximum": 500,
      "minimum": 1,
      "prefill": 20,
      "title": "Maximum records",
      "type": "integer"
    },
    "mode": {
      "default": "discover",
      "description": "What to collect: the current Discover feed, publisher/show profiles, or individual episode URLs.",
      "editor": "select",
      "enum": [
        "discover",
        "byPublisher",
        "byEpisodeUrl"
      ],
      "enumTitles": [
        "Discover feed (current stories)",
        "Publishers and shows (URLs or IDs)",
        "Episode URLs (snaps and media)"
      ],
      "prefill": "discover",
      "title": "Mode",
      "type": "string"
    },
    "proxyConfiguration": {
      "description": "Optional advanced override. The actor works without a proxy; set this only if you want to route requests through a specific Apify Proxy configuration.",
      "editor": "proxy",
      "nullable": true,
      "title": "Proxy configuration",
      "type": "object"
    },
    "publisherUrlsOrIds": {
      "default": [],
      "description": "(mode=byPublisher) Publisher or show page URLs (snapchat.com/p/<id>), story.snapchat.com links, or bare businessProfileId UUIDs. One record is produced per publisher, with the latest episodes nested inside.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Publisher URLs or IDs",
      "type": "array"
    },
    "storyTypes": {
      "default": "all",
      "description": "(mode=discover) Keep every story, only publisher shows, only public user stories, or only publisher stories.",
      "editor": "select",
      "enum": [
        "all",
        "shows",
        "publicUserStories",
        "publishers"
      ],
      "enumTitles": [
        "All stories",
        "Publisher shows only",
        "Public user stories only",
        "Publisher stories only"
      ],
      "prefill": "all",
      "title": "Story types",
      "type": "string"
    }
  },
