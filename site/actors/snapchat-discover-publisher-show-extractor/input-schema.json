    "episodeUrls": {
      "default": [],
      "description": "(mode=byEpisodeUrl) Episode page URLs of the form snapchat.com/p/<publisherId>/<storyId>. Each URL returns one episode record with its snap list and playable HLS URL.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Episode URLs",
      "type": "array"
    },
    "includeEpisodeMedia": {
      "default": false,
      "description": "(mode=byPublisher) Fetch each episode's snap list and HLS video URL. Adds one request per episode; off by default.",
      "prefill": false,
      "title": "Include episode media",
      "type": "boolean"
    },
    "includeEpisodes": {
      "default": false,
      "description": "(mode=byPublisher) Fetch every season's full episode history instead of only the 13-14 episodes embedded in the page. Adds one request per 50 episodes and respects the episode cap.",
      "prefill": false,
      "title": "Expand full season history",
      "type": "boolean"
    },
