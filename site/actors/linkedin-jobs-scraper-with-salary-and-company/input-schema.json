{
  "description": "Scrape job listings from LinkedIn. Search by keywords and location with filters, or provide direct LinkedIn job search URLs. No login required.",
  "properties": {
    "companyIds": {
      "default": [],
      "description": "Restrict search to specific LinkedIn company IDs. Find the ID in the company page URL. Applied directly by LinkedIn.",
      "editor": "stringList",
      "title": "Company IDs",
      "type": "array"
    },
    "easyApply": {
      "default": false,
      "description": "Only return jobs with LinkedIn Easy Apply. Applied directly by LinkedIn.",
      "editor": "checkbox",
      "title": "Easy Apply Only",
      "type": "boolean"
    },
    "enrichmentDepth": {
      "default": "standard",
      "description": "Standard fetches LinkedIn's lightweight job detail page (fast, low bandwidth). Full also fetches similar jobs, related jobs, related searches, and cleaner company/industry IDs from LinkedIn's full job page — but is roughly 5-7x slower per job and does not include the Apply URL, since LinkedIn does not expose it on that page.",
      "editor": "select",
      "enum": [
        "standard",
        "full"
      ],
      "enumTitles": [
        "Standard (faster)",
        "Full (more data, slower)"
      ],
      "title": "Detail Enrichment Depth",
      "type": "string"
    },
    "excludeJobIds": {
      "description": "Skip these LinkedIn job IDs (from a previous run's `id` field) — useful for incremental runs that only want new postings.",
      "editor": "stringList",
      "title": "Exclude Job IDs",
      "type": "array"
    },
    "excludeTitleKeywords": {
      "description": "Skip jobs whose title contains any of these keywords (case-insensitive) — e.g. to filter out \"Senior\" or \"Manager\" roles.",
      "editor": "stringList",
      "title": "Exclude Title Keywords",
      "type": "array"
    },
    "experienceLevel": {
      "default": "",
      "description": "Required experience level. Applied by this actor after fetching job details (LinkedIn no longer filters this server-side for public/cookieless searches) — may fetch and check more results than Max Job Listings to find enough matches, increasing run time.",
      "editor": "select",
      "enum": [
        "",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ],
      "enumTitles": [
        "Any",
        "Internship",
        "Entry level",
        "Associate",
        "Mid-Senior level",
        "Director",
        "Executive"
      ],
      "title": "Experience Level",
      "type": "string"
    },
    "function": {
      "default": "",
      "description": "Job function category. Applied by this actor after fetching job details (LinkedIn no longer filters this server-side for public/cookieless searches) — may fetch and check more results than Max Job Listings to find enough matches, increasing run time.",
