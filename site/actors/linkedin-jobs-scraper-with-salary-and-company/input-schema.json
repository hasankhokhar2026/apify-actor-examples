    "jobType": {
      "default": "",
      "description": "Employment type. Applied by this actor after fetching job details (LinkedIn no longer filters this server-side for public/cookieless searches) — may fetch and check more results than Max Job Listings to find enough matches, increasing run time.",
      "editor": "select",
      "enum": [
        "",
        "F",
        "P",
        "C",
        "T",
        "I",
        "V",
        "O"
      ],
      "enumTitles": [
        "Any",
        "Full-time",
        "Part-time",
        "Contract",
        "Temporary",
        "Internship",
        "Volunteer",
        "Other"
      ],
      "title": "Job Type",
      "type": "string"
    },
    "keywords": {
      "description": "Job title, skills, or keywords.",
      "editor": "textfield",
      "prefill": "Python Developer",
      "title": "Job Keywords",
      "type": "string"
    },
    "language": {
      "default": "en",
      "description": "Preferred language for job listings (Accept-Language header).",
      "editor": "select",
      "enum": [
        "en",
        "es",
        "fr",
        "de",
        "pt"
      ],
      "enumTitles": [
        "English",
        "Spanish",
        "French",
        "German",
        "Portuguese"
      ],
      "title": "Language",
      "type": "string"
    },
    "location": {
      "description": "City, state, country. Leave empty for worldwide. Ignored if Locations (plural) is set.",
      "editor": "textfield",
      "prefill": "United States",
      "title": "Location",
      "type": "string"
    },
    "locations": {
      "description": "Run the same Job Keywords against multiple locations in one go (e.g. ['California', 'Texas', 'New York']) and combine the deduplicated results — the best way to get more than LinkedIn's ~1,000-result cap for one keyword. Overrides Location when set.",
      "editor": "stringList",
      "title": "Locations (multiple)",
      "type": "array"
    },
    "maxItems": {
      "default": 100,
      "description": "Maximum number of jobs to scrape.",
      "editor": "number",
      "maximum": 1000,
      "minimum": 1,
      "title": "Max Job Listings",
      "type": "integer"
    },
    "proxyConfiguration": {
      "default": {
        "useApifyProxy": true
      },
      "description": "Apify proxy used for every request. Defaults to the free Datacenter (AUTO) group, which is required for reliable results -- LinkedIn's guest job pages block requests from an unproxied Apify container IP on nearly every request.",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": true
      },
      "title": "Proxy Configuration",
      "type": "object"
    },
    "salaryMin": {
      "default": 0,
      "description": "Minimum salary band. LinkedIn buckets: 1=40k+, 2=60k+, 3=80k+, 4=100k+, 5=120k+, 6=140k+, 7=160k+, 8=180k+, 9=200k+. Applied by this actor after fetching job details, only when LinkedIn's own posted salary range is available and yearly — jobs with no listed salary are not excluded. May fetch and check more results than Max Job Listings to find enough matches, increasing run time.",
      "editor": "number",
      "maximum": 9,
      "minimum": 0,
      "title": "Minimum Salary",
      "type": "integer"
    },
    "scrapeJobDetails": {
      "default": true,
      "description": "Fetch full description, seniority, type, applicant count from each job page. Slower but more complete.",
      "editor": "checkbox",
      "title": "Scrape Job Details",
      "type": "boolean"
    },
    "searchUrls": {
      "description": "Direct LinkedIn job search URLs. Overrides Keywords and Location.",
      "editor": "stringList",
      "title": "LinkedIn Search URLs",
      "type": "array"
    },
    "timePosted": {
      "default": "",
      "description": "Filter by posting date. Applied directly by LinkedIn.",
      "editor": "select",
      "enum": [
        "",
        "r86400",
        "r604800",
        "r2592000"
      ],
      "enumTitles": [
        "Any time",
        "Past 24 hours",
        "Past week",
        "Past month"
      ],
      "title": "Time Posted",
      "type": "string"
    },
    "under10Applicants": {
      "default": false,
      "description": "Only show jobs with fewer than 10 applicants. Applied directly by LinkedIn.",
      "editor": "checkbox",
      "title": "Under 10 Applicants",
      "type": "boolean"
    },
    "workType": {
      "default": "",
      "description": "On-site, remote, or hybrid. Best-effort only — LinkedIn no longer exposes a reliable on-site/remote/hybrid signal on public/cookieless pages, so this rarely narrows results today. Check the job title/description for the real work arrangement.",
      "editor": "select",
      "enum": [
        "",
        "1",
        "2",
        "3"
      ],
      "enumTitles": [
        "Any",
        "On-site",
        "Remote",
        "Hybrid"
      ],
      "title": "Work Type",
      "type": "string"
    }
  },
