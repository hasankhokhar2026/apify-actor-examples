      "type": "string"
    },
    "newsUrls": {
      "default": [],
      "description": "Google News search URLs, topic URLs, RSS search/topic URLs, or RSS/Atom feed URLs to convert into a feed.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Google News URLs (mode=newsUrl)",
      "type": "array"
    },
    "proxyConfiguration": {
      "default": {
        "useApifyProxy": false
      },
      "description": "Optional. No proxy is needed by default; Google News RSS and publisher pages work without one. Residential proxies can make Google rate-limit more, so leave this off unless you need it.",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": false
      },
      "title": "Proxy configuration",
      "type": "object"
    },
    "queries": {
      "default": [],
      "description": "One or more keyword queries. Google operators such as site:, intitle: and OR are supported. Results are deduplicated across queries.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [
        "artificial intelligence"
      ],
      "title": "Search queries (mode=keyword)",
      "type": "array"
    },
    "rssUrls": {
      "default": [],
      "description": "Any public RSS or Atom feed. Google News links inside the feed are resolved to publisher URLs automatically.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "RSS / Atom feeds (mode=rss)",
      "type": "array"
    },
    "startDate": {
      "description": "Custom range start (YYYY-MM-DD, inclusive). Also used when dateRange=custom.",
      "editor": "textfield",
      "title": "Start date",
      "type": "string"
    },
    "topics": {
      "default": [],
      "description": "Topic names (WORLD, NATION, BUSINESS, TECHNOLOGY, ENTERTAINMENT, SPORTS, SCIENCE, HEALTH), TOP for top stories, Google News topic hashes/section URLs, or topic URLs. Topic feeds ignore server-side date filters; results are filtered after download.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Topics (mode=topic)",
      "type": "array"
    }
