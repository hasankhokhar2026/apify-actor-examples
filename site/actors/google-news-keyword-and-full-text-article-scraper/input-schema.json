      "minimum": 1,
      "prefill": 100,
      "title": "Max full-text extractions",
      "type": "integer"
    },
    "maxItems": {
      "default": 500,
      "description": "Hard cap on unique records emitted by the run (1-5000).",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "maxResultsPerQuery": {
      "default": 20,
      "description": "Maximum records taken from each Google News feed request (1-100, Google's own cap is about 100). When a date range spans several days, the actor walks day windows and can collect more than 100 for one query, up to maxItems.",
      "maximum": 100,
      "minimum": 1,
      "prefill": 3,
      "title": "Max results per query window",
      "type": "integer"
    },
