{
  "description": "Search doctors and physicians on Vitals.com by specialty, name, city, or state.",
  "properties": {
    "city": {
      "description": "City to search in.",
      "editor": "textfield",
      "prefill": "New York",
      "title": "City",
      "type": "string"
    },
    "maxItems": {
      "default": 20,
