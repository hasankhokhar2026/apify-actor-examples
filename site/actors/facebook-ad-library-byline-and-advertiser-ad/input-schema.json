{
  "description": "Find Facebook Ad Library ads by advertiser Page, keyword, direct Ad Library ID, or \"Paid for by\" funding name. Returns creative text, media, run dates, platform placements, creative reuse, advertiser context, and political/EU spend, impression and reach data where Meta publishes it. No login, cookies or Meta API token required.",
  "properties": {
    "adActiveStatus": {
      "default": "active",
      "description": "Filter by ad active status.",
      "editor": "select",
      "enum": [
        "all",
        "active",
        "inactive"
      ],
      "enumTitles": [
        "All Ads",
        "Active Only",
        "Inactive Only"
      ],
      "prefill": "active",
      "title": "Ad Status",
      "type": "string"
    },
    "adIds": {
      "default": [],
      "description": "Ad Library IDs to fetch directly (numeric IDs or Ads Library URLs containing ?id=). All other filters are ignored in this mode.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Direct Ad IDs",
      "type": "array"
    },
    "adType": {
      "default": "all",
      "description": "Filter by ad category. Note: the political-and-issue archive excludes EU/EEA countries, so EU political searches automatically use All Types (EU transparency stream).",
      "editor": "select",
      "enum": [
        "all",
        "political_and_issue_ads",
        "housing",
        "employment",
        "credit"
      ],
      "enumTitles": [
        "All Types",
        "Political & Issue Ads",
        "Housing",
        "Employment",
        "Credit"
      ],
      "prefill": "all",
      "title": "Ad Type",
      "type": "string"
    },
    "bylines": {
      "default": [],
      "description": "Funding-entity / committee names from the \"Paid for by\" disclaimer on political and issue ads. The actor tries the exact-cased name, retries the original casing, and re-checks each returned ad's byline client-side. Non-EU targets search the political & issue archive; EU/EEA targets use the all-ad-types EU DSA stream (the political archive returns zero there) and may return no byline match because Meta does not always expose it.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Search by \"Paid for by\" name",
      "type": "array"
    },
