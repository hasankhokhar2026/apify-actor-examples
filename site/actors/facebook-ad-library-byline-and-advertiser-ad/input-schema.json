    "endDate": {
      "description": "Only include ads that had impressions on or before this date (YYYY-MM-DD).",
      "editor": "datepicker",
      "title": "End Date",
      "type": "string"
    },
    "includeEuDetails": {
      "default": true,
      "description": "Fetch per-ad detail data: EU total reach, age/country/gender reach breakdown, targeting, payer/beneficiary, advertiser Instagram profile and page About. Adds one extra request per ad.",
      "prefill": false,
      "title": "Include EU Transparency & Advertiser Details",
      "type": "boolean"
    },
    "maxItems": {
      "default": 1000,
      "description": "Stop the whole run after this many ads, across all search targets.",
      "maximum": 100000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max Ads (global)",
      "type": "integer"
    },
    "mediaType": {
      "default": "all",
      "description": "Filter by the ad's creative media type. `meme` is applied server-side only; Meta's payload has no meme marker, so output `media_type` is always image, video or none.",
      "editor": "select",
      "enum": [
        "all",
        "image",
        "video",
        "meme",
        "none"
      ],
      "enumTitles": [
        "All Media",
        "Image",
        "Video",
        "Meme",
        "No Media"
      ],
      "prefill": "all",
      "title": "Media Type",
      "type": "string"
    },
    "mode": {
      "default": "",
      "description": "What to scrape. Leave empty to process every target list you filled in (searchTerms, pageIds, adIds, bylines) in one run.",
      "editor": "select",
      "enum": [
        "",
        "search",
        "byPage",
        "byAdId",
        "byByline"
      ],
      "enumTitles": [
        "All provided targets (default)",
        "Search by keyword",
        "All ads from advertiser Pages",
        "Lookup specific ads by Ad Library ID",
        "Search by \"Paid for by\" name"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "onlyTotal": {
      "default": false,
      "description": "Skip ad scraping and return one total per search target per country (one lightweight page request per country, no browser). Counts respect the keyword, country, status, ad type, media type and date window; Facebook caps displayed totals at 50,001 (50,000+). Not available for byline or direct ad-ID targets, which get an unsupported_total diagnostic.",
      "prefill": false,
      "title": "Only Total Results",
      "type": "boolean"
    },
    "pageIds": {
      "default": [],
      "description": "Facebook Page IDs to fetch all ads from (numeric IDs, or URLs containing view_all_page_id= or profile.php?id=). Each page is searched separately.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Page IDs / Advertiser Search",
      "type": "array"
    },
    "publisherPlatforms": {
      "default": [],
      "description": "Only return ads shown on these platforms. Leave empty for all platforms.",
      "editor": "select",
      "items": {
        "enum": [
          "FACEBOOK",
          "INSTAGRAM",
          "MESSENGER",
          "AUDIENCE_NETWORK",
          "WHATSAPP",
          "THREADS"
        ],
        "enumTitles": [
          "Facebook",
          "Instagram",
          "Messenger",
          "Audience Network",
          "WhatsApp",
          "Threads"
        ],
        "type": "string"
      },
      "title": "Publisher Platforms",
      "type": "array",
      "uniqueItems": true
    },
    "rehostMedia": {
      "default": true,
      "description": "Copy each ad's primary media (up to 15 MB) into this run's key-value store and output the permanent URL (Facebook's own media URLs expire after a few days). The original signed URL is kept in media_url_original; media_rehost_status records rehosted/disabled/too_large/download_failed/kv_failed. Arrays, carousel cards and Page profile/cover URLs stay signed.",
      "prefill": false,
      "title": "Rehost Media URLs",
      "type": "boolean"
    },
    "resultsPerSearch": {
      "default": 50,
      "description": "Maximum number of ads to extract per search term / page / ad / byline.",
      "maximum": 100000,
      "minimum": 1,
      "prefill": 3,
      "title": "Results Per Search Term",
      "type": "integer"
    },
    "searchTerms": {
      "default": [],
      "description": "Keywords to search for in the Ad Library, one search per term. Example: [\"coffee\", \"nike\"].",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [
        "coffee"
      ],
      "title": "Search Terms",
      "type": "array"
    },
    "searchType": {
      "default": "keyword_unordered",
      "description": "How keyword search terms are matched (mode=search only).",
      "editor": "select",
      "enum": [
        "keyword_unordered",
        "keyword_exact_phrase"
      ],
      "enumTitles": [
        "Any order (default)",
        "Exact phrase"
      ],
      "prefill": "keyword_unordered",
      "title": "Keyword Match",
      "type": "string"
    },
    "sortBy": {
      "default": "relevance",
      "description": "Order results by relevance (Facebook's default) or by total impressions.",
      "editor": "select",
      "enum": [
        "relevance",
        "total_impressions"
      ],
      "enumTitles": [
        "Relevance (default)",
        "Total Impressions"
      ],
      "prefill": "relevance",
      "title": "Sort By",
      "type": "string"
    },
    "startDate": {
      "description": "Only include ads that had impressions on or after this date (YYYY-MM-DD). Combined with End Date it forms a delivery window.",
      "editor": "datepicker",
      "title": "Start Date",
      "type": "string"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Facebook Ad Library Byline & Advertiser Ad Finder Input",
  "type": "object"
}
