      "maximum": 100000,
      "minimum": 0,
      "title": "Maximum nightly price",
      "type": "integer"
    },
    "maxReviews": {
      "default": 12,
      "description": "Reviews returned per listing (1-24).",
      "maximum": 24,
      "minimum": 1,
