{
  "description": "Search Airbnb stays by city, neighborhood, place ID or map area, or load specific listing URLs. Get nightly and stay-total prices, fees, host details, amenities, reviews and a 12-month availability calendar.",
  "properties": {
    "adults": {
      "default": 1,
      "description": "Number of adult guests (1-16).",
      "maximum": 16,
      "minimum": 1,
      "title": "Adults",
      "type": "integer"
    },
    "bbox": {
      "description": "Search inside a map rectangle instead of a named location. Use decimal degrees: swLat, swLng (south-west corner) and neLat, neLng (north-east corner), plus an optional zoom (1-22). Example: {\"swLat\": 40.7075, \"swLng\": -74.0135, \"neLat\": 40.7904, \"neLng\": -73.9591, \"zoom\": 13} (mode=search).",
      "editor": "json",
      "title": "Map bounding box",
      "type": "object"
    },
    "calendarMonths": {
      "default": 12,
      "description": "Number of months to return, starting with the current month (1-12).",
      "maximum": 12,
      "minimum": 1,
      "title": "Calendar months",
      "type": "integer"
    },
    "checkIn": {
      "description": "Stay start date in YYYY-MM-DD format. Leave both dates empty to use Airbnb's displayed quote (search) or to skip the price quote (details).",
      "editor": "textfield",
      "nullable": true,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "sectionCaption": "Stay dates and guests",
      "title": "Check-in date",
      "type": "string"
    },
    "checkOut": {
      "description": "Stay end date in YYYY-MM-DD format. Must be after the check-in date.",
      "editor": "textfield",
      "nullable": true,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "title": "Check-out date",
      "type": "string"
    },
    "children": {
      "default": 0,
      "description": "Number of children aged 2-12 (0-15).",
      "maximum": 15,
      "minimum": 0,
      "title": "Children",
      "type": "integer"
    },
