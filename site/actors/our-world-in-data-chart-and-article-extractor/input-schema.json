{
  "description": "Search OWID articles and charts, download chart datasets by slug, or build country profiles with their available indicators. No login, cookie or API key.",
  "properties": {
    "articleType": {
      "default": "editorial",
      "description": "Which page types articles mode may return. 'Editorial' covers articles, data insights, announcements and topic pages; 'All' also includes profiles and featured visualizations.",
      "editor": "select",
      "enum": [
        "editorial",
        "article",
        "data-insight",
        "announcement",
        "topic-page",
        "linear-topic-page",
        "about-page",
        "featured-viz",
        "profile",
        "all"
      ],
      "enumTitles": [
        "Editorial pages (default)",
        "Articles only",
        "Data insights only",
        "Announcements only",
        "Topic pages only",
        "Linear topic pages only",
        "About pages only",
        "Featured visualizations only",
        "Profiles only",
        "Everything"
      ],
      "prefill": "editorial",
      "title": "Page type",
      "type": "string"
    },
