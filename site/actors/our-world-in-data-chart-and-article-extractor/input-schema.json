    "chartSlug": {
      "description": "A Grapher slug or full URL, e.g. 'life-expectancy' or the URL of that chart.",
      "editor": "textfield",
      "prefill": "life-expectancy",
      "sectionCaption": "Chart selection and data filters",
      "sectionDescription": "Chart modes read OWID's public Grapher CSV and metadata endpoints.",
      "title": "Chart slug or URL",
      "type": "string"
    },
    "chartSlugs": {
      "default": [],
      "description": "Several chart slugs/URLs for chartDataBulk mode.",
      "editor": "stringList",
      "prefill": [],
      "title": "Chart slugs or URLs (bulk)",
      "type": "array"
    },
    "columns": {
      "default": [],
      "description": "Keep only these data columns. Match by CSV header, short name, titleLong, display title or OWID variable ID. Empty means every column.",
      "editor": "stringList",
      "prefill": [],
      "title": "Data columns",
      "type": "array"
    },
    "countries": {
      "default": [],
      "description": "Countries mode: names, slugs or ISO codes. Empty means all listed countries, or the searchQuery country match.",
      "editor": "stringList",
      "prefill": [],
      "sectionCaption": "Country profiles",
      "sectionDescription": "Country records combine OWID profile pages with every chart available for that country.",
      "title": "Countries",
      "type": "array"
    },
    "dataFormat": {
      "default": "wide",
      "description": "'Wide' keeps one record per entity-year with one field per data column. 'Long' emits one record per entity-year-column with column, value and unit fields.",
      "editor": "select",
      "enum": [
        "wide",
        "long"
      ],
      "enumTitles": [
        "Wide (one row per entity-year)",
        "Long (one row per value)"
      ],
      "prefill": "wide",
      "title": "Chart data shape",
      "type": "string"
    },
    "dateFrom": {
      "description": "Only articles published on or after this date (YYYY-MM-DD).",
      "editor": "textfield",
      "title": "Published from",
      "type": "string"
    },
    "dateTo": {
      "description": "Only articles published on or before this date (YYYY-MM-DD).",
      "editor": "textfield",
      "title": "Published to",
      "type": "string"
    },
    "entities": {
      "default": [],
      "description": "Keep chart data rows for these entities only. Names ('Germany'), OWID/ISO codes ('DEU'), two-letter codes ('DE') and slugs all work. Empty means all entities.",
      "editor": "stringList",
      "prefill": [],
      "title": "Countries or regions",
      "type": "array"
    },
    "includeArticleDetails": {
      "default": false,
      "description": "Visit each selected article page to fill related charts and any missing page metadata. Slower; off by default.",
      "prefill": false,
      "title": "Enrich articles from their pages",
      "type": "boolean"
    },
    "includeChartConfig": {
      "default": true,
      "description": "Emit the chart's title, citation, units, column details and source URLs before its rows.",
      "prefill": true,
      "title": "Include chart metadata record",
      "type": "boolean"
    },
    "includeContent": {
      "default": false,
      "description": "Add OWID's full text to each article record (larger output).",
      "prefill": false,
      "title": "Include full article text",
      "type": "boolean"
    },
    "maxIndicatorsPerCountry": {
      "default": 100,
      "description": "How many chart indicators to list inside each country record, up to 5,000.",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 100,
      "title": "Max indicators per country",
      "type": "integer"
    },
    "maxItems": {
      "default": 100,
      "description": "Hard cap on emitted records, up to 25,000.",
      "maximum": 25000,
      "minimum": 1,
      "prefill": 100,
      "sectionCaption": "Limits",
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "articles",
      "description": "Choose what to collect.",
      "editor": "select",
      "enum": [
        "articles",
        "chartCatalog",
        "chartData",
        "chartDataBulk",
        "countries"
      ],
      "enumTitles": [
        "Articles — search and browse OWID articles",
        "Chart catalog — find chart slugs by keyword, topic or country",
        "Chart data — one chart's metadata and dataset by slug or URL",
        "Chart data bulk — several charts in one run",
        "Country profiles — a country's profile pages and available indicators"
      ],
      "prefill": "articles",
      "sectionCaption": "What to collect",
      "sectionDescription": "Pick a mode; the filters below apply to the matching mode.",
      "title": "Mode",
      "type": "string"
    },
    "searchQuery": {
      "description": "Keyword search. Used by articles mode and chart catalog mode, and as a country-name search in countries mode when no country list is set.",
      "editor": "textfield",
      "prefill": "climate change",
      "sectionCaption": "Search and article filters",
      "sectionDescription": "Articles mode searches all OWID articles, data insights, announcements and topic pages.",
      "title": "Search query",
      "type": "string"
    },
    "sortBy": {
      "default": "newest",
      "description": "Order of article records.",
      "editor": "select",
      "enum": [
        "newest",
        "oldest",
        "relevance"
      ],
      "enumTitles": [
        "Newest first",
        "Oldest first",
        "Search relevance"
      ],
      "prefill": "newest",
      "title": "Sort articles by",
      "type": "string"
    },
