{
  "description": "Scrape Google Ads Transparency Center ads by advertiser URL or ID, domain, brand or keyword search, or a single creative.",
  "properties": {
    "advertiserId": {
      "description": "Google advertiser ID starting with AR (mode=advertiser or creative).",
      "editor": "textfield",
      "title": "Advertiser ID",
      "type": "string"
    },
    "advertiserUrl": {
      "description": "Advertiser or creative URL from adstransparency.google.com (mode=advertiser or creative).",
      "editor": "textfield",
      "prefill": "https://adstransparency.google.com/advertiser/AR16735076323512287233",
      "title": "Advertiser URL",
      "type": "string"
    },
    "creativeId": {
      "description": "Google creative ID starting with CR (mode=creative). Also provide advertiserId or advertiserUrl.",
      "editor": "textfield",
      "title": "Creative ID",
      "type": "string"
    },
    "domain": {
      "description": "Domain to search across every advertiser Google links to it (mode=domain), e.g. nike.com.",
      "editor": "textfield",
      "title": "Domain",
      "type": "string"
    },
    "endDate": {
      "description": "Client-side date filter applied to the fetched slice. Leave empty for no upper bound.",
      "editor": "textfield",
      "nullable": true,
      "title": "Shown on or before (YYYY-MM-DD)",
      "type": "string"
    },
    "format": {
      "description": "Restrict to one creative format. Leave empty for all formats.",
      "editor": "select",
      "enum": [
        "TEXT",
        "IMAGE",
        "VIDEO"
      ],
      "enumTitles": [
        "Text",
        "Image",
        "Video"
      ],
      "nullable": true,
      "title": "Ad format",
      "type": "string"
    },
    "includeDetails": {
      "default": true,
      "description": "Fetch per-creative detail and preview content for copy, media and region stats. Disable for a faster list-only run.",
      "prefill": true,
      "title": "Include creative details",
      "type": "boolean"
    },
    "maxAdsPerAdvertiser": {
      "default": 20,
      "description": "Per-advertiser cap (1-1000). The run also stops at maxItems.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 1,
      "title": "Max ads per advertiser",
      "type": "integer"
    },
    "maxItems": {
      "default": 50,
      "description": "Total ads to emit across all targets (1-1000).",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 1,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "advertiser",
      "description": "Which kind of lookup to run.",
      "editor": "select",
      "enum": [
        "advertiser",
        "domain",
        "search",
        "creative"
      ],
      "enumTitles": [
        "Advertiser (URL or AR... ID)",
        "Domain (all advertisers linked to a domain)",
        "Search (brand or keyword)",
        "Creative (single ad URL or ID)"
      ],
      "prefill": "advertiser",
      "title": "Mode",
      "type": "string"
    },
    "platform": {
      "description": "Restrict to one Google surface. Leave empty for all platforms.",
      "editor": "select",
      "enum": [
        "PLAY",
        "MAPS",
        "SEARCH",
        "SHOPPING",
        "YOUTUBE"
      ],
      "enumTitles": [
        "Google Play",
        "Google Maps",
        "Google Search",
        "Google Shopping",
        "YouTube"
      ],
      "nullable": true,
      "title": "Platform",
      "type": "string"
    },
    "political": {
      "default": false,
      "description": "Return only political or issue ads. Google requires a country region for this filter.",
      "prefill": false,
      "title": "Political and issue ads only",
      "type": "boolean"
    },
    "proxyConfiguration": {
      "default": {
        "useApifyProxy": true
      },
      "description": "Optional proxy override. The actor uses an Apify automatic proxy by default.",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": true
      },
      "title": "Proxy configuration",
      "type": "object"
    },
