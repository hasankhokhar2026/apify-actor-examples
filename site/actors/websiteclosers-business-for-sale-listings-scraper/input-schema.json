      "enum": [
        "browse",
        "byCategory",
        "search",
        "closedDeals",
        "byUrls"
      ],
      "enumTitles": [
        "Browse live listings",
        "Browse selected categories",
        "Keyword search",
        "Browse sold deals",
        "Look up specific listings"
      ],
      "prefill": "browse",
      "sectionCaption": "What to scrape",
      "sectionDescription": "Choose live listings, an industry view, a keyword search, the sold-deal archive, or exact listing lookups.",
      "title": "Mode",
      "type": "string"
    },
    "onlyNew": {
      "default": false,
      "description": "Skip listings returned by an earlier run with the same filters. Useful for scheduled runs. The first run returns everything and remembers what it returned.",
