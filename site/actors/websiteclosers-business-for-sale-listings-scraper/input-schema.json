      "prefill": false,
      "title": "SBA pre-qualified only",
      "type": "boolean"
    },
    "searchInDescription": {
      "default": false,
      "description": "Match search phrases against the full description too. Slower because every candidate listing must be opened.",
      "editor": "checkbox",
      "prefill": false,
      "title": "Also search full descriptions",
      "type": "boolean"
    },
    "searchQueries": {
      "default": [],
      "description": "Words or phrases to match against listing titles and summaries, for example 'Amazon FBA', 'SaaS' or 'agency'. Multiple phrases are combined with OR.",
      "editor": "stringList",
      "prefill": [],
      "sectionCaption": "Keyword search",
      "sectionDescription": "Optional. Each phrase is matched against the listing title and card summary; multiple phrases are combined with OR.",
      "title": "Search phrases",
      "type": "array"
    },
    "searchScope": {
      "default": "live",
      "description": "Search live listings, sold deals, or both. 'Both' spends about half the result budget on live deals first, then fills the rest from the sold archive.",
      "editor": "select",
      "enum": [
        "live",
        "sold",
        "both"
      ],
      "enumTitles": [
        "Live listings",
        "Sold deals",
        "Live and sold"
      ],
      "prefill": "live",
      "title": "Search scope (mode=search)",
      "type": "string"
    },
    "sort": {
      "default": "newest",
      "description": "Order of the result list.",
      "editor": "select",
      "enum": [
        "newest",
        "priceDesc",
        "priceAsc",
        "cashFlowDesc",
        "cashFlowAsc",
        "revenueDesc",
        "revenueAsc"
      ],
      "enumTitles": [
        "Newest first",
        "Asking price: high to low",
        "Asking price: low to high",
        "Cash flow: high to low",
        "Cash flow: low to high",
        "Revenue: high to low",
        "Revenue: low to high"
      ],
      "prefill": "newest",
      "title": "Sort by",
      "type": "string"
    },
    "statuses": {
      "default": [],
      "description": "Keep only these deal statuses. Available and pending apply to live listings; sold applies to the sold archive. Leave empty for all.",
