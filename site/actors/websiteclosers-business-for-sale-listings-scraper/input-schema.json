      "items": {
        "enum": [
          "available",
          "pending",
          "sold"
        ],
        "enumTitles": [
          "Available",
          "Pending / under contract",
          "Sold"
        ],
        "type": "string"
      },
      "prefill": [],
      "sectionCaption": "Status and deal filters",
      "title": "Statuses",
      "type": "array"
    }
