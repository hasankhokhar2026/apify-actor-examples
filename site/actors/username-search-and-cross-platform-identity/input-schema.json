{
  "description": "Search usernames across 400+ social networks, filter to specific target networks, verify found profiles, optionally extract public profile details, or resolve which candidate account on a target network truly belongs to a given source profile.",
  "properties": {
    "candidateHandles": {
      "default": [],
      "description": "Handles to verify against the source profile on the single target network (required when candidateMode is 'verify'). Capped at 60 to keep existence checks bounded. The legacy `handles` key is still accepted.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "maxItems": 60,
      "prefill": [],
      "title": "Candidate Handles",
      "type": "array"
    },
    "candidateMode": {
      "default": "discover",
      "description": "discover: auto-generate candidates via search + username-variation heuristics. verify: score only the candidateHandles you supply.",
      "editor": "select",
      "enum": [
        "discover",
        "verify"
      ],
      "enumTitles": [
        "Discover",
        "Verify a supplied shortlist"
      ],
      "prefill": "discover",
      "title": "Candidate Mode",
      "type": "string"
    },
    "extractProfileFields": {
      "default": false,
      "description": "Opt in to public profile details (display name, bio, avatar, location, follower count where the source exposes them) in both modes. Identity resolution always fetches what it needs for scoring, but emits the optional detail fields only when this is on. Adds one request per found profile. Off by default; empty and unverifiable avatar URLs are omitted.",
      "prefill": false,
      "title": "Extract profile details",
      "type": "boolean"
    },
    "includeNsfw": {
      "default": false,
      "description": "When no targetNetworks are supplied, also check the 17 adult/NSFW sites in the site database. Off by default.",
      "prefill": false,
      "title": "Include adult / NSFW sites",
      "type": "boolean"
    },
    "includeUnreliable": {
      "default": false,
      "description": "When no targetNetworks are supplied, also check the 8 sites that reported random control handles as found in live testing. Their results are marked unreliable. Off by default.",
      "prefill": false,
      "title": "Include sites with known false positives",
      "type": "boolean"
    },
    "maxCandidatesToDiscover": {
      "default": 20,
      "description": "Upper bound on generated/searched candidates per target network in discover mode.",
      "maximum": 60,
      "minimum": 1,
      "prefill": 20,
      "title": "Max Candidates To Discover",
      "type": "integer"
    },
    "maxConcurrency": {
      "default": 2,
      "description": "How many usernames are searched at the same time in broadSearch. Lower this on a small-memory run.",
      "maximum": 5,
      "minimum": 1,
      "prefill": 1,
      "title": "Max concurrent usernames",
      "type": "integer"
    },
    "maxUsernames": {
      "default": 100,
      "description": "How many usernames a broadSearch run will process. Defaults to 100; raise it to 500 for larger batches. When input is truncated, the status message and each record's warnings state how many usernames were skipped.",
      "maximum": 500,
      "minimum": 1,
      "prefill": 1,
      "title": "Max usernames",
      "type": "integer"
    },
    "minConfidenceScore": {
      "default": 0.3,
      "description": "A candidate becomes bestMatch only when its confidence score reaches this value (0-1). Lower it to see weaker matches; raise it for stricter matching.",
      "maximum": 1,
      "minimum": 0,
      "prefill": 0.3,
      "title": "Minimum Confidence Score",
      "type": "number"
    },
    "mode": {
      "default": "broadSearch",
      "description": "broadSearch: check usernames across networks (optionally filtered) and return every found profile with its status. identityResolution: disambiguate which candidate account on a target network matches a source profile.",
      "editor": "select",
      "enum": [
        "broadSearch",
        "identityResolution"
      ],
      "enumTitles": [
        "Broad Search",
        "Identity Resolution"
      ],
      "prefill": "broadSearch",
      "sectionCaption": "Mode",
      "title": "Mode",
      "type": "string"
    },
    "requestTimeoutSecs": {
      "default": 20,
      "description": "Per-site timeout for existence checks and profile verification.",
      "maximum": 60,
      "minimum": 5,
      "prefill": 15,
      "title": "Request timeout (seconds)",
      "type": "integer"
    },
    "sourceOverrides": {
      "description": "Optional manual displayName/bio/avatarUrl for the source profile, used when the source platform cannot be read or to supplement missing data.",
      "editor": "json",
      "title": "Source Overrides",
      "type": "object"
    },
    "sourceProfile": {
      "description": "The known account to resolve against (mode=identityResolution). Example: {\"platform\": \"github\", \"handle\": \"torvalds\"}. The legacy `profile` key is still accepted.",
      "editor": "json",
      "prefill": {
        "handle": "torvalds",
        "platform": "github"
      },
      "sectionCaption": "Identity Resolution",
      "title": "Source Profile",
      "type": "object"
    },
    "targetNetworks": {
      "description": "Limit the search/resolution to these networks. Omit to check the 410-site safe sweep (435 vendored sites minus 17 adult/NSFW and 8 known-false-positive sites; Reddit is only checked when explicitly targeted). In identityResolution this field is required; candidateMode 'verify' requires exactly one network. Discord, Diskusjon.no, and Kvinneguiden are skipped with a warning in identity mode because the site database has no username profile URL template for them. Reddit is checked through its public JSON endpoint.",
      "editor": "select",
