{
  "description": "Search usernames across 400+ social networks, filter to specific target networks, or resolve which candidate account on a target network truly belongs to a given source profile.",
  "properties": {
    "candidateHandles": {
      "description": "Handles to verify against the source profile on the single target network (required when candidateMode is 'verify').",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Candidate Handles",
      "type": "array"
    },
    "candidateMode": {
      "default": "discover",
      "description": "discover: auto-generate candidates via search + username-variation heuristics. verify: score only the candidateHandles you supply.",
      "editor": "select",
      "enum": [
        "discover",
        "verify"
      ],
      "enumTitles": [
        "Discover",
        "Verify"
      ],
      "prefill": "discover",
      "title": "Candidate Mode",
      "type": "string"
    },
    "maxCandidatesToDiscover": {
      "default": 20,
      "description": "Upper bound on generated/searched candidates per target network in discover mode.",
      "maximum": 60,
      "minimum": 1,
      "prefill": 20,
      "title": "Max Candidates To Discover",
      "type": "integer"
    },
    "mode": {
      "default": "broadSearch",
      "description": "broadSearch: check usernames across networks (optionally filtered). identityResolution: disambiguate which candidate account on a target network matches a source profile.",
      "editor": "select",
      "enum": [
        "broadSearch",
        "identityResolution"
      ],
      "enumTitles": [
        "Broad Search",
        "Identity Resolution"
      ],
      "prefill": "broadSearch",
      "sectionCaption": "Mode",
      "title": "Mode",
      "type": "string"
    },
    "sourceOverrides": {
      "description": "Optional manual displayName/bio/avatarUrl for the source profile, used when the source platform can't be auto-scraped (e.g. Instagram) or to supplement missing data.",
      "editor": "json",
      "title": "Source Overrides",
      "type": "object"
    },
    "sourceProfile": {
      "description": "The known account to resolve against (identityResolution mode). Example: {\"platform\": \"instagram\", \"handle\": \"xyz\"}.",
      "editor": "json",
      "prefill": {
        "handle": "xyz",
        "platform": "instagram"
      },
      "sectionCaption": "Identity Resolution",
      "title": "Source Profile",
      "type": "object"
    },
    "targetNetworks": {
      "description": "Limit the search/resolution to these networks. Optional filter in broadSearch (omit to search all 400+). Required (1+) in identityResolution; exactly one network required when candidateMode is 'verify'. The list covers every network Sherlock supports plus Reddit (resolved via its own public search API for identityResolution).",
